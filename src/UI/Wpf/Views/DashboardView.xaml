<UserControl x:Class="ApexTweaker.UI.Wpf.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             FontFamily="Segoe UI Variable Display, Segoe UI, Arial">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/MacTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Border Style="{StaticResource MacCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource MacSectionLabel}"
                               Text="AUTO-TUNING" />
                    <TextBlock Margin="0,6,0,0"
                               Style="{StaticResource MacPageTitle}"
                               FontSize="22"
                               Text="Otimizar ao m&#x00E1;ximo" />
                    <TextBlock Margin="0,8,0,20"
                               Style="{StaticResource MacBodyText}"
                               Text="O perfil ideal &#x00E9; escolhido automaticamente com base no seu hardware." />
                    <Button x:Name="AutoOptimizeButton"
                            Style="{StaticResource MacPrimaryButton}"
                            Content="&#x26A1; Otimizar sistema"
                            Click="AutoOptimizeButton_OnClick" />
                </StackPanel>
            </Border>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource MacCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MacSectionLabel}"
                                   Text="SEGURAN&#x00C7;A" />
                        <TextBlock Margin="0,6,0,0"
                                   Style="{StaticResource MacSectionTitle}"
                                   Text="Ponto de restaura&#x00E7;&#x00E3;o" />
                        <TextBlock Margin="0,8,0,16"
                                   Style="{StaticResource MacBodyText}"
                                   Text="Recomendado antes de pacotes agressivos." />
                        <Button x:Name="RestorePointButton"
                                Style="{StaticResource MacSecondaryButton}"
                                Content="Criar restore point"
                                Click="RestorePointButton_OnClick" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource MacCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MacSectionLabel}"
                                   Text="HARDWARE" />
                        <TextBlock Margin="0,6,0,0"
                                   Style="{StaticResource MacSectionTitle}"
                                   Text="Resumo" />
                        <TextBlock x:Name="SummaryText"
                                   Margin="0,12,0,0"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="14"
                                   LineHeight="22"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
