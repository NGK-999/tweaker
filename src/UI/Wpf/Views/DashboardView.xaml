<UserControl x:Class="ApexTweaker.UI.Wpf.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource ContentBgBrush}"
             FontFamily="Segoe UI Variable Display, Segoe UI, Arial">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/MacTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,8,12" MaxWidth="760" HorizontalAlignment="Left">
            <!-- Primary action: one CTA, no nested hero card -->
            <TextBlock Style="{StaticResource MacSectionTitle}"
                       Text="Otimizar com seguran&#x00E7;a" />
            <TextBlock Margin="0,6,0,14"
                       Style="{StaticResource MacBodyText}"
                       FontSize="13"
                       Text="Detecta o hardware, cria backup e aplica o perfil compat&#x00ED;vel com esta m&#x00E1;quina."
                       TextWrapping="Wrap" />
            <Button x:Name="AutoOptimizeButton"
                    Width="220"
                    HorizontalAlignment="Left"
                    Style="{StaticResource MacPrimaryButton}"
                    Content="Otimizar sistema"
                    AutomationProperties.Name="Otimizar sistema automaticamente"
                    Click="AutoOptimizeButton_OnClick" />
            <TextBlock Margin="0,8,0,0"
                       Style="{StaticResource MacBodyText}"
                       FontSize="12"
                       Foreground="{DynamicResource TextTertiaryBrush}"
                       Text="Backup antes de cada pacote. Revers&#x00ED;vel em Utilidades."
                       TextWrapping="Wrap" />

            <Border Margin="0,22,0,0"
                    Padding="0,16,0,0"
                    BorderBrush="{DynamicResource SeparatorBrush}"
                    BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource MacSectionLabel}" Text="Seguran&#x00E7;a" />
                        <TextBlock Margin="0,6,0,0"
                                   Style="{StaticResource MacSectionTitle}"
                                   Text="Ponto de restaura&#x00E7;&#x00E3;o" />
                        <TextBlock Margin="0,6,0,12"
                                   Style="{StaticResource MacBodyText}"
                                   FontSize="12"
                                   Text="Prote&#x00E7;&#x00E3;o adicional antes de ajustes agressivos."
                                   TextWrapping="Wrap" />
                        <Button x:Name="RestorePointButton"
                                HorizontalAlignment="Left"
                                Style="{StaticResource MacSecondaryButton}"
                                Content="Criar ponto de restaura&#x00E7;&#x00E3;o"
                                AutomationProperties.Name="Criar ponto de restaura&#x00E7;&#x00E3;o do Windows"
                                Click="RestorePointButton_OnClick" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource MacSectionLabel}" Text="Hardware" />
                        <TextBlock Margin="0,6,0,8"
                                   Style="{StaticResource MacSectionTitle}"
                                   Text="Resumo detectado" />
                        <TextBlock x:Name="SummaryText"
                                   FontFamily="{StaticResource MacMonoFont}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="12"
                                   LineHeight="20"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
