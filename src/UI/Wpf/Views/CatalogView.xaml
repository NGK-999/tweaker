<UserControl x:Class="ApexTweaker.UI.Wpf.Views.CatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ApexTweaker.UI.Wpf.Controls"
             Background="{DynamicResource ContentBgBrush}"
             FontFamily="Segoe UI Variable Display, Segoe UI, Arial">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/MacTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis" />

            <Style x:Key="CatalogSettingsRow" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource CardBgBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="14,12" />
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,12">
        <StackPanel MaxWidth="920" HorizontalAlignment="Left">

            <TextBlock Style="{StaticResource MacSectionLabel}" Text="CATALOGO" />
            <TextBlock Margin="0,6,0,0"
                       Style="{StaticResource MacPageTitle}"
                       FontSize="20"
                       Text="Otimizacoes Windows" />
            <TextBlock Margin="0,6,0,0"
                       Style="{StaticResource MacBodyText}"
                       FontSize="13"
                       TextWrapping="Wrap"
                       Text="Somente analise nesta tela. Auto-Optimize nunca aplica itens perigosos. BIOS e checklist sem flash." />

            <Border Margin="0,18,0,0" Style="{StaticResource MacCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource MacSectionTitle}" Text="Preset" />
                        <TextBlock Margin="0,4,0,10"
                                   Style="{StaticResource MacBodyText}"
                                   FontSize="12"
                                   Text="Escolha o perfil e gere a lista recomendada para este PC." />
                        <ComboBox x:Name="PresetCombo"
                                  Width="260"
                                  HorizontalAlignment="Left"
                                  SelectionChanged="PresetCombo_OnSelectionChanged" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            VerticalAlignment="Bottom"
                            Style="{StaticResource MacPrimaryButton}"
                            Content="Analisar"
                            Click="AnalyzeButton_OnClick" />
                </Grid>
            </Border>

            <TextBlock x:Name="StatusText"
                       Margin="0,12,0,4"
                       Style="{StaticResource MacBodyText}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Text="Selecione um preset e analise." />

            <TextBlock Margin="0,18,0,10" Style="{StaticResource MacSectionTitle}" Text="Regras" />
            <ItemsControl x:Name="RulesList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CatalogSettingsRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Margin="0,0,12,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                   Text="{Binding Category}" />
                                        <TextBlock Margin="10,0,0,0"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   Text="{Binding KindLabel}" />
                                    </StackPanel>
                                    <TextBlock Margin="0,5,0,0"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               Text="{Binding Name}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Margin="0,5,0,0"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="{Binding Impact}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Margin="0,4,0,0"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                               Text="{Binding Reason}"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Top"
                                            HorizontalAlignment="Right">
                                    <controls:RiskBadge Level="{Binding BadgeLevel}" HorizontalAlignment="Right" />
                                    <controls:RiskBadge Margin="0,6,0,0"
                                                        Level="Restart"
                                                        HorizontalAlignment="Right"
                                                        Visibility="{Binding RequiresRestart, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Margin="0,22,0,10" Style="{StaticResource MacSectionTitle}" Text="BIOS checklist" />
            <TextBlock Margin="0,0,0,10"
                       Style="{StaticResource MacBodyText}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Text="Orientacao manual. O app nao grava firmware UEFI." />
            <ItemsControl x:Name="BiosList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CatalogSettingsRow}">
                            <StackPanel>
                                <TextBlock FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Text="{Binding Title}"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,2,0,0"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           Text="{Binding Vendor}" />
                                <TextBlock Margin="0,6,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="{Binding Guidance}"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="11"
                                           Foreground="{DynamicResource WarningBrush}"
                                           Text="{Binding RiskNote}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
