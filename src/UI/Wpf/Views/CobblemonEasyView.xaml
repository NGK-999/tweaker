<UserControl x:Class="ApexTweaker.UI.Wpf.Views.CobblemonEasyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             Background="{DynamicResource ContentBgBrush}"
             FontFamily="Segoe UI Variable Display, Segoe UI, Arial">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/MacTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

            <Style x:Key="EasyStepIndicator" TargetType="Border">
                <Setter Property="MinHeight" Value="70" />
                <Setter Property="Margin" Value="0,0,8,0" />
                <Setter Property="Padding" Value="12" />
                <Setter Property="Background" Value="{DynamicResource CardBgBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Style.Triggers>
                    <Trigger Property="Tag" Value="True">
                        <Setter Property="Background" Value="{DynamicResource InfoSurfaceBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="EasyCheck" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                <Setter Property="Margin" Value="0,0,16,9" />
                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                <Setter Property="FontSize" Value="12" />
            </Style>

            <Style TargetType="Expander">
                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            </Style>

            <Style x:Key="EasyScrollThumb" TargetType="{x:Type primitives:Thumb}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type primitives:Thumb}">
                            <Border Margin="2,1"
                                    Background="{DynamicResource CardBorderBrush}"
                                    BorderBrush="{DynamicResource TextTertiaryBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="{x:Type ScrollBar}">
                <Setter Property="Width" Value="10" />
                <Setter Property="Background" Value="{DynamicResource ChartBgBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ScrollBar}">
                            <Grid Width="10" Background="{TemplateBinding Background}">
                                <primitives:Track x:Name="PART_Track"
                                                  IsDirectionReversed="True"
                                                  Maximum="{TemplateBinding Maximum}"
                                                  Minimum="{TemplateBinding Minimum}"
                                                  Orientation="Vertical"
                                                  Value="{TemplateBinding Value}"
                                                  ViewportSize="{TemplateBinding ViewportSize}">
                                    <primitives:Track.DecreaseRepeatButton>
                                        <RepeatButton Background="Transparent" BorderThickness="0"
                                                      Command="{x:Static ScrollBar.PageUpCommand}"
                                                      Focusable="False" Opacity="0" />
                                    </primitives:Track.DecreaseRepeatButton>
                                    <primitives:Track.Thumb>
                                        <primitives:Thumb MinHeight="28" Style="{StaticResource EasyScrollThumb}" />
                                    </primitives:Track.Thumb>
                                    <primitives:Track.IncreaseRepeatButton>
                                        <RepeatButton Background="Transparent" BorderThickness="0"
                                                      Command="{x:Static ScrollBar.PageDownCommand}"
                                                      Focusable="False" Opacity="0" />
                                    </primitives:Track.IncreaseRepeatButton>
                                </primitives:Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Margin="0,0,0,2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,14,36">
                <Border Style="{StaticResource MacCardStyle}" BorderBrush="{Binding StateColor}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource MacSectionLabel}" Text="MINECRAFT R&#x00C1;PIDO" />
                            <TextBlock Margin="0,6,0,0"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="25"
                                       FontWeight="SemiBold"
                                       Text="Prepare o jogo em poucos cliques."
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,8,0,0"
                                       MaxWidth="720"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="12"
                                       Text="Encontre a instala&#x00E7;&#x00E3;o, prepare com backup e teste. Mods nunca s&#x00E3;o movidos ou apagados por este modo."
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,12,0,0"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       FontSize="12"
                                       Text="{Binding SelectedPath}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Border Grid.Column="1"
                                Margin="18,0,0,0"
                                Padding="14,9"
                                VerticalAlignment="Top"
                                Background="{DynamicResource PanelBgBrush}"
                                BorderBrush="{Binding StateColor}"
                                BorderThickness="1"
                                CornerRadius="18">
                            <TextBlock Foreground="{Binding StateColor}"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Text="{Binding OverallStatus}" />
                        </Border>
                    </Grid>
                </Border>

                <Border Margin="0,12,0,0"
                        Padding="16"
                        Background="{DynamicResource PanelBgBrush}"
                        BorderBrush="{DynamicResource PanelBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="250" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,20,0">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="34" Height="34" Background="{Binding StateColor}" CornerRadius="17">
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{DynamicResource OnAccentTextBrush}" FontFamily="Segoe MDL2 Assets"
                                               FontSize="17" Text="&#xE946;" />
                                </Border>
                                <TextBlock Margin="12,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Text="{Binding StatusMessage}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock Margin="46,7,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="12"
                                       Text="{Binding InstanceDetails}"
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="46,6,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Text="{Binding SelectedPlayTarget, StringFormat=Destino do teste: {0}}" />
                        </StackPanel>
                        <Button x:Name="PrimaryActionButton"
                                Grid.Column="1"
                                Width="250"
                                Height="48"
                                VerticalAlignment="Center"
                                Style="{StaticResource MacPrimaryButton}"
                                AutomationProperties.Name="Executar a pr&#x00F3;xima etapa do Minecraft"
                                Click="PrimaryActionButton_OnClick" />
                    </Grid>
                </Border>

                <UniformGrid Margin="0,12,0,0" Columns="4">
                    <Border Style="{StaticResource EasyStepIndicator}"
                            Tag="{Binding DetectStep.IsCurrent}">
                        <StackPanel>
                            <TextBlock Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" Text="1  Encontrar" />
                            <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Text="{Binding DetectStep.StateLabel}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource EasyStepIndicator}"
                            Tag="{Binding OptimizeStep.IsCurrent}">
                        <StackPanel>
                            <TextBlock Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" Text="2  Preparar" />
                            <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Text="{Binding OptimizeStep.StateLabel}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource EasyStepIndicator}"
                            Tag="{Binding TestStep.IsCurrent}">
                        <StackPanel>
                            <TextBlock Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" Text="3  Testar" />
                            <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Text="{Binding TestStep.StateLabel}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                    <Border Margin="0" Style="{StaticResource EasyStepIndicator}"
                            Tag="{Binding FixStep.IsCurrent}">
                        <StackPanel>
                            <TextBlock Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" Text="4  Resolver" />
                            <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Text="{Binding FixStep.StateLabel}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Border Margin="0,12,0,0" Style="{StaticResource MacCardStyle}"
                        Background="{DynamicResource WarningSurfaceBrush}"
                        BorderBrush="{DynamicResource WarningBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource MacSectionLabel}" Text="HOOKS DE SESSAO" />
                            <TextBlock Margin="0,6,0,0"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Text="Temporarios no Java do Minecraft — rollback automatico ao terminar o teste."
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,6,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="12"
                                       Text="Extremo = prioridade High + P-cores (se hibrido) + Power Mode Best Performance. Sem RealTime, sem kernel, sem injecao."
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource MacSectionLabel}" Text="MODO" />
                            <ComboBox x:Name="EasyHookModeComboBox"
                                      Width="140"
                                      Margin="0,5,0,0"
                                      SelectedItem="{Binding SelectedHookMode, Mode=TwoWay}"
                                      SelectionChanged="EasyHookModeComboBox_OnSelectionChanged"
                                      ToolTip="Seguro: AboveNormal + HighQoS. Extremo: High + afinidade hibrida + Best Performance." />
                        </StackPanel>
                    </Grid>
                </Border>

                <Expander Margin="0,10,0,0" Header="Ajustes opcionais">
                    <Border Margin="0,9,0,0" Style="{StaticResource MacCardStyle}">
                        <StackPanel>
                            <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                                       Text="O padr&#x00E3;o &#x00E9; recomendado para PCs fracos. Altere somente se precisar."
                                       TextWrapping="Wrap" />
                            <WrapPanel Margin="0,12,0,0">
                                <CheckBox Margin="0,16,18,0" VerticalAlignment="Center"
                                          Foreground="{DynamicResource TextSecondaryBrush}"
                                          Content="Resolu&#x00E7;&#x00E3;o m&#x00ED;nima (854x480)"
                                          IsChecked="{Binding UseExtremeResolution, Mode=TwoWay}" />
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Style="{StaticResource MacSectionLabel}" Text="LIMITE DE FPS" />
                                    <ComboBox x:Name="EasyFpsComboBox" Width="100" Margin="0,5,0,0"
                                              ItemStringFormat="{}{0} FPS"
                                              SelectedItem="{Binding SelectedFps, Mode=TwoWay}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource MacSectionLabel}" Text="ONDE VAI JOGAR" />
                                    <ComboBox x:Name="EasyPlayTargetComboBox" Width="120" Margin="0,5,0,0"
                                              SelectedItem="{Binding SelectedPlayTarget, Mode=TwoWay}" />
                                </StackPanel>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </Expander>

                <Expander Margin="0,10,0,0" Header="Ver detalhes da verifica&#x00E7;&#x00E3;o">
                    <Border Margin="0,9,0,0" Style="{StaticResource MacCardStyle}">
                        <StackPanel>
                            <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                                       Text="{Binding ModDetails}" TextWrapping="Wrap" />
                            <TextBlock Margin="0,10,0,0" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                                       Text="{Binding ServerDetails}" TextWrapping="Wrap" />
                            <TextBlock Margin="0,10,0,0" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                                       Text="{Binding CorrectionDetails}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Expander>

                <Border x:Name="TestResultPanel"
                        Margin="0,12,0,0"
                        Style="{StaticResource MacCardStyle}"
                        Visibility="{Binding IsTestPanelVisible, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MacSectionLabel}" Text="COMO FOI O TESTE?" />
                        <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="15" FontWeight="SemiBold"
                                   Text="Marque somente o que voc&#x00EA; observou." />
                        <ProgressBar Height="5" Margin="0,12,0,0" Maximum="100"
                                     Value="{Binding BenchmarkProgress, Mode=OneWay}"
                                     Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource ControlDisabledBrush}" />
                        <TextBlock Margin="0,7,0,0" Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="12" Text="{Binding BenchmarkSummary}" TextWrapping="Wrap" />
                        <WrapPanel Margin="0,13,0,0">
                            <CheckBox x:Name="GameOpenedCheckBox"
                                      Style="{StaticResource EasyCheck}"
                                      AutomationProperties.Name="O jogo abriu"
                                      Content="O jogo abriu"
                                      IsChecked="{Binding GameOpened}" />
                            <CheckBox Style="{StaticResource EasyCheck}"
                                      AutomationProperties.Name="{Binding DestinationQuestion}"
                                      Content="{Binding DestinationQuestion}"
                                      IsChecked="{Binding ReachedDestination}" />
                            <CheckBox Style="{StaticResource EasyCheck}"
                                      AutomationProperties.Name="O jogo travou muito"
                                      Content="Travou muito"
                                      IsChecked="{Binding SevereStutter}" />
                        </WrapPanel>
                        <Expander Margin="0,4,0,0" Header="Adicionar detalhes do problema">
                            <StackPanel Margin="0,10,0,0">
                                <WrapPanel>
                                    <CheckBox Style="{StaticResource EasyCheck}" Content="Chegou ao menu" IsChecked="{Binding MenuReached}" />
                                    <CheckBox Style="{StaticResource EasyCheck}" Content="Fechou sozinho" IsChecked="{Binding ClosedAlone}" />
                                    <CheckBox Style="{StaticResource EasyCheck}" Content="Apareceu erro de mod" IsChecked="{Binding ModError}" />
                                </WrapPanel>
                                <WrapPanel Margin="0,4,0,0">
                                    <StackPanel Width="180" Margin="0,0,12,10">
                                        <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Text="FPS aproximado (opcional)" />
                                        <TextBox Height="36" Margin="0,5,0,0" Padding="10,6"
                                                 AutomationProperties.Name="FPS aproximado opcional"
                                                 AutomationProperties.HelpText="Informe o FPS visto no F3 ou deixe vazio."
                                                 Background="{DynamicResource PanelBgBrush}"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                 BorderBrush="{DynamicResource PanelBorderBrush}"
                                                 Text="{Binding ApproximateFps, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Width="360" Margin="0,0,0,10">
                                        <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Text="Observa&#x00E7;&#x00E3;o ou erro (opcional)" />
                                        <TextBox Height="36" Margin="0,5,0,0" Padding="10,6"
                                                 AutomationProperties.Name="Observa&#x00E7;&#x00E3;o ou erro opcional"
                                                 AutomationProperties.HelpText="Descreva brevemente um travamento ou mensagem de erro."
                                                 Background="{DynamicResource PanelBgBrush}"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                 BorderBrush="{DynamicResource PanelBorderBrush}"
                                                 Text="{Binding UserNotes, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </WrapPanel>
                            </StackPanel>
                        </Expander>
                        <Button x:Name="SaveTestButton"
                                MinWidth="180"
                                Margin="0,12,0,0"
                                HorizontalAlignment="Right"
                                Style="{StaticResource MacPrimaryButton}"
                                Content="Concluir teste"
                                AutomationProperties.Name="Concluir teste do Minecraft"
                                Click="SaveTestButton_OnClick" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Margin="0,8,6,0" Padding="12"
                Background="{DynamicResource PanelBgBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" CornerRadius="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="RestoreButton" Style="{StaticResource MacDestructiveButton}"
                        Content="Restaurar" ToolTip="Dispon&#x00ED;vel depois de criar um backup."
                        ToolTipService.ShowOnDisabled="True" Click="RestoreButton_OnClick" />
                <TextBlock Grid.Column="1" Margin="14,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextTertiaryBrush}" FontSize="10"
                           Text="Volta &#x00E0;s configura&#x00E7;&#x00F5;es anteriores. Seus mods permanecem intactos."
                           TextWrapping="Wrap" />
                <Button x:Name="ExportButton" Grid.Column="2" Style="{StaticResource MacSecondaryButton}"
                        Content="Exportar diagn&#x00F3;stico"
                        ToolTip="Dispon&#x00ED;vel depois de preparar ou testar."
                        ToolTipService.ShowOnDisabled="True" Click="ExportButton_OnClick" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
