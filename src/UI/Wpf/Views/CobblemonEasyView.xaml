<UserControl x:Class="ApexTweaker.UI.Wpf.Views.CobblemonEasyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             Background="Transparent"
             FontFamily="Segoe UI Variable Display, Segoe UI, Arial">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/MacTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

            <Style x:Key="EasyActionButton" TargetType="Button">
                <Setter Property="MinHeight" Value="112" />
                <Setter Property="Margin" Value="0,0,10,10" />
                <Setter Property="Padding" Value="16" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="Background" Value="#132033" />
                <Setter Property="BorderBrush" Value="#2B3D58" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Card"
                                    Padding="{TemplateBinding Padding}"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="13">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Card" Property="Background" Value="#192A42" />
                                    <Setter TargetName="Card" Property="BorderBrush" Value="#4DA3FF" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Card" Property="Opacity" Value="0.82" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Card" Property="Opacity" Value="0.56" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="EasyMetric" TargetType="Border">
                <Setter Property="Margin" Value="0,0,8,0" />
                <Setter Property="Padding" Value="12" />
                <Setter Property="Background" Value="#101B2B" />
                <Setter Property="BorderBrush" Value="#263750" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
            </Style>

            <Style x:Key="EasyCheck" TargetType="CheckBox">
                <Setter Property="Margin" Value="0,0,16,9" />
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                <Setter Property="FontSize" Value="12" />
            </Style>

            <Style TargetType="Expander">
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            </Style>

            <Style x:Key="EasyScrollThumb" TargetType="{x:Type primitives:Thumb}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type primitives:Thumb}">
                            <Border Margin="2,1"
                                    Background="#3A4D67"
                                    BorderBrush="#506681"
                                    BorderThickness="1"
                                    CornerRadius="4" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="{x:Type ScrollBar}">
                <Setter Property="Width" Value="10" />
                <Setter Property="Background" Value="#0B1421" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ScrollBar}">
                            <Grid Width="10" Background="{TemplateBinding Background}">
                                <primitives:Track x:Name="PART_Track"
                                                  IsDirectionReversed="True"
                                                  Maximum="{TemplateBinding Maximum}"
                                                  Minimum="{TemplateBinding Minimum}"
                                                  Orientation="Vertical"
                                                  Value="{TemplateBinding Value}"
                                                  ViewportSize="{TemplateBinding ViewportSize}">
                                    <primitives:Track.DecreaseRepeatButton>
                                        <RepeatButton Background="Transparent"
                                                      BorderThickness="0"
                                                      Command="{x:Static ScrollBar.PageUpCommand}"
                                                      Focusable="False"
                                                      Opacity="0" />
                                    </primitives:Track.DecreaseRepeatButton>
                                    <primitives:Track.Thumb>
                                        <primitives:Thumb MinHeight="28" Style="{StaticResource EasyScrollThumb}" />
                                    </primitives:Track.Thumb>
                                    <primitives:Track.IncreaseRepeatButton>
                                        <RepeatButton Background="Transparent"
                                                      BorderThickness="0"
                                                      Command="{x:Static ScrollBar.PageDownCommand}"
                                                      Focusable="False"
                                                      Opacity="0" />
                                    </primitives:Track.IncreaseRepeatButton>
                                </primitives:Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Margin="0,0,0,2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,14,38">
                <Border Style="{StaticResource MacCardStyle}" BorderBrush="{Binding StateColor}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource MacSectionLabel}" Text="MINECRAFT F&#x00C1;CIL" />
                            <TextBlock Margin="0,6,0,0"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="25"
                                       FontWeight="SemiBold"
                                       Text="Otimize qualquer inst&#x00E2;ncia sem entender Java ou logs."
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,8,0,0"
                                       MaxWidth="720"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="12"
                                       Text="Detectar, analisar, otimizar e testar. Nada e apagado, mods nao sao movidos e toda configuracao escrita pode ser restaurada."
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,12,0,0"
                                       Foreground="{StaticResource TextTertiaryBrush}"
                                       FontSize="10"
                                       Text="{Binding SelectedPath}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Top">
                            <Button x:Name="PrimaryDetectButton"
                                    MinWidth="190"
                                    Style="{StaticResource MacPrimaryButton}"
                                    Content="Detectar Inst&#x00E2;ncia Agora"
                                    Visibility="{Binding IsPrimaryDetectCtaVisible, Converter={StaticResource BoolToVisibility}}"
                                    Click="DetectButton_OnClick" />
                            <Border Padding="14,9"
                                    Background="#101B2B"
                                    BorderBrush="{Binding StateColor}"
                                    BorderThickness="1"
                                    CornerRadius="18"
                                    Visibility="{Binding IsStatusBadgeVisible, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Foreground="{Binding StateColor}"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Text="{Binding OverallStatus}" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Margin="0,12,0,0"
                        Padding="15"
                        Background="#101B2B"
                        BorderBrush="#2A3A52"
                        BorderThickness="1"
                        CornerRadius="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="34" Height="34" Background="{Binding StateColor}" CornerRadius="17">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="#08111E"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="17"
                                       Text="&#xE946;" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,16,0">
                            <TextBlock Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Text="{Binding StatusMessage}"
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,5,0,0"
                                       Foreground="{StaticResource TextTertiaryBrush}"
                                       FontSize="11"
                                       Text="{Binding InstanceDetails}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Grid.Column="2"
                                   VerticalAlignment="Center"
                                   Foreground="{Binding StateColor}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Text="{Binding NextAction}"
                                   TextWrapping="Wrap" />
                    </Grid>
                </Border>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Button x:Name="DetectButton" Grid.Row="0" Grid.Column="0" Style="{StaticResource EasyActionButton}" Background="{Binding DetectStep.Background}" BorderBrush="{Binding DetectStep.BorderBrush}" Click="DetectButton_OnClick">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <TextBlock DockPanel.Dock="Left" Foreground="#4DA3FF" FontSize="11" FontWeight="Bold" Text="1  DETECTAR" />
                                <TextBlock Margin="8,0,0,0" Foreground="{Binding DetectStep.Color}" FontSize="9" FontWeight="SemiBold" Text="{Binding DetectStep.StateLabel}" />
                            </DockPanel>
                            <TextBlock Margin="0,7,0,0" FontSize="16" FontWeight="SemiBold" Text="Detectar Instancia" />
                            <TextBlock Margin="0,6,0,0" Foreground="{StaticResource TextTertiaryBrush}" FontSize="10" Text="Procura Prism, MultiMC e Modrinth ou permite selecionar a pasta." TextWrapping="Wrap" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="AnalyzeButton" Grid.Row="0" Grid.Column="1" Style="{StaticResource EasyActionButton}" Background="{Binding AnalyzeStep.Background}" BorderBrush="{Binding AnalyzeStep.BorderBrush}" Click="AnalyzeButton_OnClick">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <TextBlock DockPanel.Dock="Left" Foreground="#67D89B" FontSize="11" FontWeight="Bold" Text="2  ANALISAR" />
                                <TextBlock Margin="8,0,0,0" Foreground="{Binding AnalyzeStep.Color}" FontSize="9" FontWeight="SemiBold" Text="{Binding AnalyzeStep.StateLabel}" />
                            </DockPanel>
                            <TextBlock Margin="0,7,0,0" FontSize="16" FontWeight="SemiBold" Text="Analisar Mods" />
                            <TextBlock Margin="0,6,0,0" Foreground="{StaticResource TextTertiaryBrush}" FontSize="10" Text="Resume essenciais, performance, peso visual, duplicatas e riscos." TextWrapping="Wrap" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="OptimizeButton"
                            Grid.Row="0"
                            Grid.Column="2"
                            Style="{StaticResource EasyActionButton}"
                            Background="{Binding OptimizeStep.Background}"
                            BorderBrush="{Binding OptimizeStep.BorderBrush}"
                            Click="OptimizeButton_OnClick">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <TextBlock DockPanel.Dock="Left" Foreground="#67D89B" FontSize="11" FontWeight="Bold" Text="3  PRINCIPAL" />
                                <TextBlock Margin="8,0,0,0" Foreground="{Binding OptimizeStep.Color}" FontSize="9" FontWeight="SemiBold" Text="{Binding OptimizeStep.StateLabel}" />
                            </DockPanel>
                            <TextBlock Margin="0,7,0,0" FontSize="16" FontWeight="SemiBold" Text="Otimizar para PC Fraco" />
                            <TextBlock Margin="0,6,0,0" Foreground="#A5DCC1" FontSize="10" Text="Cria backup e aplica o perfil POTATO_4GB. Nenhum mod e alterado." TextWrapping="Wrap" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="ServerButton" Grid.Row="1" Grid.Column="0" Style="{StaticResource EasyActionButton}" Background="{Binding ServerStep.Background}" BorderBrush="{Binding ServerStep.BorderBrush}" Click="ServerButton_OnClick">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <TextBlock DockPanel.Dock="Left" Foreground="#F2A65A" FontSize="11" FontWeight="Bold" Text="4  MULTIPLAYER" />
                                <TextBlock Margin="8,0,0,0" Foreground="{Binding ServerStep.Color}" FontSize="9" FontWeight="SemiBold" Text="{Binding ServerStep.StateLabel}" />
                            </DockPanel>
                            <TextBlock Margin="0,7,0,0" FontSize="16" FontWeight="SemiBold" Text="Validar Multiplayer" />
                            <TextBlock Margin="0,6,0,0" Foreground="{StaticResource TextTertiaryBrush}" FontSize="10" Text="Confere requisitos e duplicatas sem remover ou mover JARs." TextWrapping="Wrap" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="TestButton" Grid.Row="1" Grid.Column="1" Style="{StaticResource EasyActionButton}" Background="{Binding TestStep.Background}" BorderBrush="{Binding TestStep.BorderBrush}" Click="TestButton_OnClick">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <TextBlock DockPanel.Dock="Left" Foreground="#4DA3FF" FontSize="11" FontWeight="Bold" Text="5  TESTAR" />
                                <TextBlock Margin="8,0,0,0" Foreground="{Binding TestStep.Color}" FontSize="9" FontWeight="SemiBold" Text="{Binding TestStep.StateLabel}" />
                            </DockPanel>
                            <TextBlock Margin="0,7,0,0" FontSize="16" FontWeight="SemiBold" Text="Testar Jogo" />
                            <TextBlock Margin="0,6,0,0" Foreground="{StaticResource TextTertiaryBrush}" FontSize="10" Text="Mede 60 segundos, coleta logs e depois faz perguntas simples." TextWrapping="Wrap" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="FixButton"
                            Grid.Row="1"
                            Grid.Column="2"
                            Style="{StaticResource EasyActionButton}"
                            Background="{Binding FixStep.Background}"
                            BorderBrush="{Binding FixStep.BorderBrush}"
                            ToolTip="Dispon&#x00ED;vel ap&#x00F3;s testar o jogo."
                            ToolTipService.ShowOnDisabled="True"
                            Click="FixButton_OnClick">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <TextBlock DockPanel.Dock="Left" Foreground="#F5B942" FontSize="11" FontWeight="Bold" Text="6  CORRIGIR" />
                                <TextBlock Margin="8,0,0,0" Foreground="{Binding FixStep.Color}" FontSize="9" FontWeight="SemiBold" Text="{Binding FixStep.StateLabel}" />
                            </DockPanel>
                            <TextBlock Margin="0,7,0,0" FontSize="16" FontWeight="SemiBold" Text="Corrigir Problemas" />
                            <TextBlock Margin="0,6,0,0" Foreground="{StaticResource TextTertiaryBrush}" FontSize="10" Text="Traduz memoria, stutter, incompatibilidade ou crash em proximas acoes seguras." TextWrapping="Wrap" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Border Margin="0,2,0,0" Style="{StaticResource MacCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource MacSectionLabel}" Text="CONFIGURACAO AUTOMATICA" />
                            <TextBlock Margin="0,6,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11"
                                       Text="Padr&#x00E3;o: 960x540, render 2, simula&#x00E7;&#x00E3;o 5, entidades 30%, 24 FPS, heap 2048 MB e hook Seguro."
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <WrapPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
                            <CheckBox Margin="0,16,16,0"
                                      VerticalAlignment="Center"
                                      Foreground="{StaticResource TextSecondaryBrush}"
                                      Content="Usar 854x480"
                                      IsChecked="{Binding UseExtremeResolution, Mode=TwoWay}" />
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Style="{StaticResource MacSectionLabel}" Text="FPS" />
                                <ComboBox x:Name="EasyFpsComboBox"
                                          Width="86"
                                          Margin="0,5,0,0"
                                          ItemStringFormat="{}{0} FPS"
                                          SelectedItem="{Binding SelectedFps, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Style="{StaticResource MacSectionLabel}" Text="HOOK DE SESS&#x00C3;O" />
                                <ComboBox x:Name="EasyHookModeComboBox"
                                          Width="112"
                                          Margin="0,5,0,0"
                                          SelectedItem="{Binding SelectedHookMode, Mode=TwoWay}"
                                          ToolTip="Seguro usa somente APIs documentadas no processo Java. Extremo adiciona prioridade High e afinidade h&#x00ED;brida quando suportada." />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Style="{StaticResource MacSectionLabel}" Text="DESTINO" />
                                <ComboBox x:Name="EasyPlayTargetComboBox"
                                          Width="112"
                                          Margin="0,5,0,0"
                                          SelectedItem="{Binding SelectedPlayTarget, Mode=TwoWay}" />
                            </StackPanel>
                        </WrapPanel>
                    </Grid>
                </Border>

                <Border Margin="0,12,0,0" Style="{StaticResource MacCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MacSectionLabel}" Text="RESUMO DOS MODS" />
                        <UniformGrid Margin="0,10,0,0" Columns="5">
                            <Border Style="{StaticResource EasyMetric}"><StackPanel><TextBlock Style="{StaticResource MacSectionLabel}" Text="ESSENCIAIS" /><TextBlock Margin="0,5,0,0" Style="{StaticResource MacMetricValue}" Text="{Binding EssentialMods}" /></StackPanel></Border>
                            <Border Style="{StaticResource EasyMetric}"><StackPanel><TextBlock Style="{StaticResource MacSectionLabel}" Text="PERFORMANCE" /><TextBlock Margin="0,5,0,0" Style="{StaticResource MacMetricValue}" Text="{Binding PerformanceMods}" /></StackPanel></Border>
                            <Border Style="{StaticResource EasyMetric}"><StackPanel><TextBlock Style="{StaticResource MacSectionLabel}" Text="PESADOS" /><TextBlock Margin="0,5,0,0" Style="{StaticResource MacMetricValue}" Text="{Binding HeavyMods}" /></StackPanel></Border>
                            <Border Style="{StaticResource EasyMetric}"><StackPanel><TextBlock Style="{StaticResource MacSectionLabel}" Text="DUPLICATAS" /><TextBlock Margin="0,5,0,0" Style="{StaticResource MacMetricValue}" Text="{Binding DuplicateMods}" /></StackPanel></Border>
                            <Border Style="{StaticResource EasyMetric}" Margin="0"><StackPanel><TextBlock Style="{StaticResource MacSectionLabel}" Text="RISCOS" /><TextBlock Margin="0,5,0,0" Style="{StaticResource MacMetricValue}" Text="{Binding RiskCount}" /></StackPanel></Border>
                        </UniformGrid>

                        <Expander Margin="0,10,0,0" Header="Ver detalhes do resumo">
                            <TextBlock Margin="0,8,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11"
                                       Text="{Binding ModDetails}"
                                       TextWrapping="Wrap" />
                        </Expander>
                        <Expander Margin="0,7,0,0" Header="Compatibilidade com servidor">
                            <TextBlock Margin="0,8,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11"
                                       Text="{Binding ServerDetails}"
                                       TextWrapping="Wrap" />
                        </Expander>
                        <Expander Margin="0,7,0,0" Header="Recomendacoes depois do teste">
                            <TextBlock Margin="0,8,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11"
                                       Text="{Binding CorrectionDetails}"
                                       TextWrapping="Wrap" />
                        </Expander>
                    </StackPanel>
                </Border>

                <Border Margin="0,12,0,0"
                        Style="{StaticResource MacCardStyle}"
                        Visibility="{Binding IsTestPanelVisible, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MacSectionLabel}" Text="TESTE DO JOGO" />
                        <TextBlock Margin="0,6,0,0"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Text="Responda somente o que voce observou." />
                        <ProgressBar Height="5"
                                     Margin="0,12,0,0"
                                     Maximum="100"
                                     Value="{Binding BenchmarkProgress, Mode=OneWay}"
                                     Foreground="#4DA3FF"
                                     Background="#17253A" />
                        <TextBlock Margin="0,7,0,0"
                                   Foreground="{StaticResource TextTertiaryBrush}"
                                   FontSize="10"
                                   Text="{Binding BenchmarkSummary}"
                                   TextWrapping="Wrap" />
                        <WrapPanel Margin="0,13,0,0">
                            <CheckBox Style="{StaticResource EasyCheck}" Content="O jogo abriu" IsChecked="{Binding GameOpened}" />
                            <CheckBox Style="{StaticResource EasyCheck}" Content="Chegou ao menu" IsChecked="{Binding MenuReached}" />
                            <CheckBox Style="{StaticResource EasyCheck}" Content="Entrou no mundo" IsChecked="{Binding WorldEntered}" />
                            <CheckBox Style="{StaticResource EasyCheck}" Content="Entrou no servidor" IsChecked="{Binding ServerEntered}" />
                            <CheckBox Style="{StaticResource EasyCheck}" Content="Travou muito" IsChecked="{Binding SevereStutter}" />
                            <CheckBox Style="{StaticResource EasyCheck}" Content="Fechou sozinho" IsChecked="{Binding ClosedAlone}" />
                            <CheckBox Style="{StaticResource EasyCheck}" Content="Apareceu erro de mod" IsChecked="{Binding ModError}" />
                        </WrapPanel>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Height="36"
                                     Padding="10,6"
                                     Background="#101B2B"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                                     BorderBrush="#2B3D58"
                                     Text="{Binding ApproximateFps, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="FPS aproximado, se voce observou pelo F3. Deixe vazio se nao souber." />
                            <TextBox Grid.Column="1"
                                     Height="36"
                                     Margin="10,0,10,0"
                                     Padding="10,6"
                                     Background="#101B2B"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                                     BorderBrush="#2B3D58"
                                     Text="{Binding UserNotes, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Observacao curta ou mensagem de erro." />
                            <Button Grid.Column="2"
                                    Style="{StaticResource MacPrimaryButton}"
                                    Content="Salvar respostas"
                                    Click="SaveTestButton_OnClick" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1"
                Margin="0,8,6,0"
                Padding="12"
                Background="#0D1726"
                BorderBrush="#263750"
                BorderThickness="1"
                CornerRadius="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="RestoreButton"
                        Style="{StaticResource MacDestructiveButton}"
                        Content="Restaurar Tudo"
                        ToolTip="Dispon&#x00ED;vel ap&#x00F3;s criar um backup."
                        ToolTipService.ShowOnDisabled="True"
                        Click="RestoreButton_OnClick" />
                <TextBlock Grid.Column="1"
                           Margin="14,0"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextTertiaryBrush}"
                           FontSize="10"
                           Text="Restaura apenas alteracoes gerenciadas pelo ultimo backup. JARs permanecem intactos."
                           TextWrapping="Wrap" />
                <Button x:Name="ExportButton"
                        Grid.Column="2"
                        Style="{StaticResource MacSecondaryButton}"
                        Content="Exportar Diagnostico"
                        ToolTip="Dispon&#x00ED;vel ap&#x00F3;s executar an&#x00E1;lise ou teste."
                        ToolTipService.ShowOnDisabled="True"
                        Click="ExportButton_OnClick" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
