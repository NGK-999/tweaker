<UserControl x:Class="ApexTweaker.UI.Wpf.Views.ModulesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ApexTweaker.UI.Wpf.Controls"
             Background="{DynamicResource ContentBgBrush}"
             FontFamily="Segoe UI Variable Display, Segoe UI, Arial">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/MacTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="ModuleRow" TargetType="Grid">
                <Setter Property="Margin" Value="0,0,0,6" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,8,12" MaxWidth="860" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource MacBodyText}"
                       FontSize="13"
                       Text="Cada acao aplica snapshot antes de alterar e pode ser revertida em Utilidades." />

            <TextBlock Margin="0,20,0,8"
                       Style="{StaticResource MacSectionTitle}"
                       Text="CPU e energia" />
            <StackPanel x:Name="CoreButtonsPanel">
                <Grid Style="{StaticResource ModuleRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="168" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource MacModuleButton}" Tag="CPU/Scheduler" Content="CPU/Scheduler" Click="ModuleButton_OnClick" />
                    <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource MacBodyText}" FontSize="12" Text="Prioridade e agendamento MMCSS para jogos." />
                    <controls:RiskBadge Grid.Column="2" Margin="8,0,0,0" Level="Safe" />
                </Grid>
                <Grid Style="{StaticResource ModuleRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="168" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource MacModuleButton}" Tag="GPU/Display" Content="GPU/Display" Click="ModuleButton_OnClick" />
                    <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource MacBodyText}" FontSize="12" Text="HAGS, Game Mode e otimizacoes de tela cheia." />
                    <controls:RiskBadge Grid.Column="2" Margin="8,0,0,0" Level="Safe" />
                </Grid>
                <Grid Style="{StaticResource ModuleRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="168" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource MacModuleButton}" Tag="Energia" Content="Energia" Click="ModuleButton_OnClick" />
                    <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource MacBodyText}" FontSize="12" Text="Plano de energia maximo e resfriamento ativo." />
                    <controls:RiskBadge Grid.Column="2" Margin="8,0,0,0" Level="Safe" />
                </Grid>
                <Grid Style="{StaticResource ModuleRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="168" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource MacModuleButton}" Tag="Lat&#x00EA;ncia extrema" Content="Lat&#x00EA;ncia extrema" Click="ModuleButton_OnClick" />
                    <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource MacBodyText}" FontSize="12" Text="Perfil agressivo de energia e scheduler; aumenta consumo." />
                    <controls:RiskBadge Grid.Column="2" Margin="8,0,0,0" Level="Advanced" />
                </Grid>
            </StackPanel>

            <TextBlock Margin="0,16,0,8"
                       Style="{StaticResource MacSectionTitle}"
                       Text="Rede e perifericos" />
            <StackPanel x:Name="PeripheralButtonsPanel">
                <Grid Style="{StaticResource ModuleRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="168" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource MacModuleButton}" Tag="Input/USB" Content="Input/USB" Click="ModuleButton_OnClick" />
                    <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource MacBodyText}" FontSize="12" Text="Remove aceleracao do mouse e suspensao seletiva de USB." />
                    <controls:RiskBadge Grid.Column="2" Margin="8,0,0,0" Level="Safe" />
                </Grid>
                <Grid Style="{StaticResource ModuleRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="168" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource MacModuleButton}" Tag="Rede" Content="Rede" Click="ModuleButton_OnClick" />
                    <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource MacBodyText}" FontSize="12" Text="Reduz limitacao de rede e ajusta adaptadores." />
                    <controls:RiskBadge Grid.Column="2" Margin="8,0,0,0" Level="Safe" />
                </Grid>
                <Grid Style="{StaticResource ModuleRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="168" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource MacModuleButton}" Tag="Pol&#x00ED;ticas/Servi&#x00E7;os" Content="Pol&#x00ED;ticas/Servi&#x00E7;os" Click="ModuleButton_OnClick" />
                    <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource MacBodyText}" FontSize="12" Text="Desliga servi&#x00E7;os e pol&#x00ED;ticas do Windows (Xbox, Busca, WER)." />
                    <controls:RiskBadge Grid.Column="2"
                                         Margin="8,0,0,0"
                                         Level="Advanced"
                                         ToolTip="Altera servi&#x00E7;os do Windows. Revis&#x00E3;o antes de aplicar recomendada." />
                </Grid>
            </StackPanel>

            <TextBlock Margin="0,16,0,8"
                       Style="{StaticResource MacSectionTitle}"
                       Text="GPU e background" />
            <StackPanel x:Name="GpuButtonsPanel">
                <Grid Style="{StaticResource ModuleRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="168" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource MacModuleButton}" Tag="GPU Windows" Content="GPU Windows" Click="ModuleButton_OnClick" />
                    <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource MacBodyText}" FontSize="12" Text="Aplica ajustes de GPU expostos pelo proprio Windows." />
                    <controls:RiskBadge Grid.Column="2" Margin="8,0,0,0" Level="Safe" />
                </Grid>
                <Grid Style="{StaticResource ModuleRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="168" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource MacModuleButton}" Tag="GPU regedit" Content="GPU regedit" Click="ModuleButton_OnClick" />
                    <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource MacBodyText}" FontSize="12" Text="Ajustes de Registro por fabricante de GPU, com backup .reg." />
                    <controls:RiskBadge Grid.Column="2" Margin="8,0,0,0" Level="Advanced" />
                </Grid>
                <Grid Style="{StaticResource ModuleRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="168" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource MacModuleButton}" Tag="Background" Content="Background" Click="ModuleButton_OnClick" />
                    <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource MacBodyText}" FontSize="12" Text="Desliga Game DVR/App Capture e reduz paineis do Game Bar." />
                    <controls:RiskBadge Grid.Column="2" Margin="8,0,0,0" Level="Safe" />
                </Grid>
            </StackPanel>

            <TextBlock Margin="0,16,0,8"
                       Style="{StaticResource MacSectionTitle}"
                       Text="Jogos" />
            <StackPanel x:Name="GamesButtonsPanel">
                <Grid Style="{StaticResource ModuleRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="168" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Style="{StaticResource MacModuleButton}"
                            Tag="Minecraft"
                            Content="Minecraft / Cobblemon"
                            AutomationProperties.Name="Executar otimizacao Minecraft e Cobblemon"
                            Click="ModuleButton_OnClick" />
                    <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource MacBodyText}" FontSize="12" Text="Detecta instancia, audita mods e aplica perfil (pede confirmacao antes de gravar)." />
                    <controls:RiskBadge Grid.Column="2" Margin="8,0,0,0" Level="Safe" />
                </Grid>
            </StackPanel>

            <TextBlock Margin="0,16,0,8"
                       Style="{StaticResource MacSectionTitle}"
                       Text="Mercado" />
            <StackPanel x:Name="MarketButtonsPanel">
                <Grid Style="{StaticResource ModuleRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="168" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource MacModuleButton}" Tag="UI noise" Content="UI noise" Click="ModuleButton_OnClick" />
                    <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource MacBodyText}" FontSize="12" Text="Reduz animacoes e ruido visual do shell." />
                    <controls:RiskBadge Grid.Column="2" Margin="8,0,0,0" Level="Safe" />
                </Grid>
                <Grid Style="{StaticResource ModuleRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="168" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource MacModuleButton}" Tag="Memory" Content="Memory" Click="ModuleButton_OnClick" />
                    <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource MacBodyText}" FontSize="12" Text="Ajustes de memoria e working set para jogos." />
                    <controls:RiskBadge Grid.Column="2" Margin="8,0,0,0" Level="Safe" />
                </Grid>
                <Grid Style="{StaticResource ModuleRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="168" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource MacModuleButton}" Tag="Rede avancada" Content="Rede avancada" Click="ModuleButton_OnClick" />
                    <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource MacBodyText}" FontSize="12" Text="Tweaks de rede alem do pacote basico." />
                    <controls:RiskBadge Grid.Column="2" Margin="8,0,0,0" Level="Advanced" />
                </Grid>
                <Grid Style="{StaticResource ModuleRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="168" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource MacModuleButton}" Tag="Debloat" Content="Debloat" Click="ModuleButton_OnClick" />
                    <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource MacBodyText}" FontSize="12" Text="Remove apps e componentes opcionais ruidosos." />
                    <controls:RiskBadge Grid.Column="2" Margin="8,0,0,0" Level="Advanced" />
                </Grid>
                <Grid Style="{StaticResource ModuleRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="168" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource MacModuleButton}" Tag="Timer resolution" Content="Timer resolution" Click="ModuleButton_OnClick" />
                    <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource MacBodyText}" FontSize="12" Text="Timer de alta precisao para latencia." />
                    <controls:RiskBadge Grid.Column="2" Margin="8,0,0,0" Level="Advanced" />
                </Grid>
            </StackPanel>

            <Expander Margin="0,18,0,0"
                      IsExpanded="False"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      FontFamily="{StaticResource MacFont}"
                      FontSize="13"
                      FontWeight="SemiBold"
                      Header="WinUtil-inspired (CTT)">
                <StackPanel Margin="0,10,0,0">
                    <TextBlock Margin="0,0,0,10"
                               Style="{StaticResource MacBodyText}"
                               FontSize="12"
                               Text="Reimplementado no pipeline Apex (ledger/Demo). Nao executa scripts do Chris Titus." />
                    <Grid Style="{StaticResource ModuleRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="168" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Style="{StaticResource MacModuleButton}"
                                Tag="CTT Essential"
                                Content="CTT Essential"
                                Click="ModuleButton_OnClick" />
                        <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource MacBodyText}" FontSize="12"
                                   Text="Telemetria leve, widgets, location, WPBT, limpeza e Ultimate Performance." />
                        <controls:RiskBadge Grid.Column="2" Margin="8,0,0,0" Level="Safe" />
                    </Grid>
                    <Grid Style="{StaticResource ModuleRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="168" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Style="{StaticResource MacModuleButton}"
                                Tag="CTT Advanced"
                                Content="CTT Advanced"
                                Click="ModuleButton_OnClick" />
                        <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource MacBodyText}" FontSize="12"
                                   Text="CAUTION: background apps, notificacoes, menu classico, IPv4 preferido, AI pages." />
                        <controls:RiskBadge Grid.Column="2" Margin="8,0,0,0" Level="Advanced" />
                    </Grid>
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
