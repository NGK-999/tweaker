<UserControl x:Class="ApexTweaker.UI.Wpf.Views.MinecraftView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             FontFamily="Segoe UI Variable Display, Segoe UI, Arial">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/MacTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="MinecraftTextBox" TargetType="TextBox">
                <Setter Property="Height" Value="40" />
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="Background" Value="{StaticResource CardElevatedBrush}" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <Style x:Key="MetricCard" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource CardElevatedBrush}" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="14" />
                <Setter Property="Margin" Value="0,0,10,0" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,8,8">
            <Border Style="{StaticResource MacCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Style="{StaticResource MacSectionLabel}"
                                   Text="COBBLEMON LOW-END LAB" />
                        <TextBlock Margin="0,6,0,0"
                                   Style="{StaticResource MacPageTitle}"
                                   FontSize="22"
                                   Text="Audite primeiro. Mude depois." />
                        <TextBlock Margin="0,10,0,0"
                                   MaxWidth="680"
                                   Style="{StaticResource MacBodyText}"
                                   Text="Leitura de metadados reais dos JARs, dependencias aninhadas, conflitos e perfis reversiveis. Mods nunca sao excluidos automaticamente." />
                    </StackPanel>

                    <Border Grid.Column="1"
                            Width="126"
                            Height="72"
                            Margin="24,0,0,0"
                            Background="#14281F"
                            BorderBrush="#2B8A5A"
                            BorderThickness="1"
                            CornerRadius="14">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock HorizontalAlignment="Center"
                                       Foreground="#67D89B"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Text="MODO SEGURO" />
                            <TextBlock HorizontalAlignment="Center"
                                       Margin="0,5,0,0"
                                       Foreground="{StaticResource TextTertiaryBrush}"
                                       FontSize="11"
                                       Text="sem apagar JARs" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Margin="0,14,0,0" Style="{StaticResource MacCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource MacSectionLabel}"
                               Text="PASTA DE MODS OU INSTANCIA" />
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="PathTextBox"
                                 Grid.Column="0"
                                 Style="{StaticResource MinecraftTextBox}"
                                 TextChanged="PathTextBox_OnTextChanged"
                                 ToolTip="Selecione a pasta mods ou a raiz da instancia" />
                        <Button x:Name="BrowseButton"
                                Grid.Column="1"
                                Width="108"
                                Margin="10,0,0,0"
                                Style="{StaticResource MacSecondaryButton}"
                                Content="Selecionar"
                                Click="BrowseButton_OnClick" />
                        <Button x:Name="AuditButton"
                                Grid.Column="2"
                                Width="112"
                                Margin="10,0,0,0"
                                Style="{StaticResource MacPrimaryButton}"
                                Content="Auditar"
                                Click="AuditButton_OnClick" />
                    </Grid>
                    <TextBlock x:Name="InstanceStateText"
                               Margin="0,10,0,0"
                               Foreground="{StaticResource TextTertiaryBrush}"
                               FontSize="12"
                               Text="A auditoria aceita qualquer pasta com JARs. Perfis exigem options.txt e subpasta mods." />
                </StackPanel>
            </Border>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource MetricCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MacSectionLabel}" Text="MODS" />
                        <TextBlock x:Name="TotalModsText" Margin="0,6,0,0" Style="{StaticResource MacMetricValue}" Text="--" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource MetricCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MacSectionLabel}" Text="PERFORMANCE" />
                        <TextBlock x:Name="PerformanceModsText" Margin="0,6,0,0" Style="{StaticResource MacMetricValue}" Text="--" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource MetricCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MacSectionLabel}" Text="DUPLICADOS" />
                        <TextBlock x:Name="DuplicateModsText" Margin="0,6,0,0" Style="{StaticResource MacMetricValue}" Text="--" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="3"
                        Margin="0"
                        Style="{StaticResource MetricCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MacSectionLabel}" Text="ALERTAS" />
                        <TextBlock x:Name="IssuesText" Margin="0,6,0,0" Style="{StaticResource MacMetricValue}" Text="--" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.12*" />
                    <ColumnDefinition Width="0.88*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Margin="0,0,7,0"
                        Style="{StaticResource MacCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MacSectionLabel}" Text="DIAGNOSTICO" />
                        <TextBlock x:Name="EnvironmentText"
                                   Margin="0,8,0,0"
                                   Style="{StaticResource MacBodyText}"
                                   Text="Execute a auditoria para ler hardware, Java, pagefile e processos pesados." />
                        <ListBox x:Name="IssueList"
                                 Height="142"
                                 Margin="0,12,0,0"
                                 Padding="0"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{StaticResource TextSecondaryBrush}"
                                 FontSize="12"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1"
                        Margin="7,0,0,0"
                        Style="{StaticResource MacCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MacSectionLabel}" Text="PERFIL REVERSIVEL" />
                        <ComboBox x:Name="ProfileComboBox"
                                  Height="40"
                                  Margin="0,10,0,0"
                                  Padding="10,5"
                                  Background="{StaticResource CardElevatedBrush}"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  BorderBrush="{StaticResource CardBorderBrush}"
                                  DisplayMemberPath="DisplayName" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="96" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center"
                                       Style="{StaticResource MacBodyText}"
                                       Text="Limite de FPS para esta rodada" />
                            <ComboBox x:Name="FpsComboBox"
                                      Grid.Column="1"
                                      Height="36"
                                      Padding="10,4"
                                      Background="{StaticResource CardElevatedBrush}"
                                      Foreground="{StaticResource TextPrimaryBrush}"
                                      BorderBrush="{StaticResource CardBorderBrush}" />
                        </Grid>
                        <Button x:Name="PreviewProfileButton"
                                Margin="0,10,0,0"
                                Style="{StaticResource MacSecondaryButton}"
                                Content="Previsualizar (dry-run)"
                                Click="PreviewProfileButton_OnClick" />
                        <Button x:Name="ApplyProfileButton"
                                Margin="0,8,0,0"
                                Style="{StaticResource MacPrimaryButton}"
                                Content="Aplicar plano com backup"
                                Click="ApplyProfileButton_OnClick" />
                        <Button x:Name="RollbackButton"
                                Margin="0,8,0,0"
                                Style="{StaticResource MacSecondaryButton}"
                                Content="Restaurar ultimo perfil"
                                Click="RollbackButton_OnClick" />
                        <TextBlock Margin="0,12,0,0"
                                   Foreground="{StaticResource TextTertiaryBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Text="Prism/MultiMC recebem memoria por instancia. Outros launchers recebem instrucoes manuais claras." />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.12*" />
                    <ColumnDefinition Width="0.88*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Margin="0,0,7,0"
                        Style="{StaticResource MacCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MacSectionLabel}" Text="QUARENTENA REVERSIVEL" />
                        <TextBlock Margin="0,7,0,0"
                                   Style="{StaticResource MacBodyText}"
                                   Text="Selecione somente os JARs confirmados. A auditoria apenas monta o dry-run; nenhum item vem marcado automaticamente." />
                        <ListBox x:Name="QuarantineList"
                                 Height="178"
                                 Margin="0,10,0,0"
                                 Padding="4"
                                 Background="{StaticResource CardElevatedBrush}"
                                 BorderBrush="{StaticResource CardBorderBrush}"
                                 BorderThickness="1"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 SelectionMode="Extended"
                                 SelectionChanged="QuarantineList_OnSelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="5,4">
                                        <TextBlock FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding FileName}" />
                                        <TextBlock Margin="0,2,0,0"
                                                   Foreground="{StaticResource TextTertiaryBrush}"
                                                   FontSize="10"
                                                   TextWrapping="Wrap">
                                            <Run Text="Risco " />
                                            <Run Text="{Binding Risk}" />
                                            <Run Text=" | " />
                                            <Run Text="{Binding Reason}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="ApplyQuarantineButton"
                                    Grid.Column="0"
                                    Margin="0,0,5,0"
                                    Style="{StaticResource MacPrimaryButton}"
                                    Content="Mover selecionados"
                                    Click="ApplyQuarantineButton_OnClick" />
                            <Button x:Name="RollbackQuarantineButton"
                                    Grid.Column="1"
                                    Margin="5,0,0,0"
                                    Style="{StaticResource MacSecondaryButton}"
                                    Content="Desfazer quarentena"
                                    Click="RollbackQuarantineButton_OnClick" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1"
                        Margin="7,0,0,0"
                        Style="{StaticResource MacCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MacSectionLabel}" Text="PLANO DE SOBREVIVENCIA 4 GB" />
                        <TextBlock x:Name="SurvivalVerdictText"
                                   Margin="0,8,0,0"
                                   Foreground="#67D89B"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Text="Execute a auditoria para gerar um veredito realista."
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="SurvivalDetailsText"
                                   Margin="0,10,0,0"
                                   Style="{StaticResource MacBodyText}"
                                   Text="O plano combina JVM, mods, graficos, riscos e recomendacoes manuais."
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Margin="0,14,0,0" Style="{StaticResource MacCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource MacSectionLabel}" Text="HOMOLOGACAO OPERACIONAL" />
                    <TextBlock Margin="0,7,0,0"
                               Style="{StaticResource MacBodyText}"
                               Text="Registre somente o que foi observado no PC alvo. FPS ausente permanece NAO MEDIDO."
                               TextWrapping="Wrap" />

                    <WrapPanel Margin="0,12,0,0">
                        <CheckBox x:Name="GameOpenedCheckBox" Margin="0,0,18,8" Foreground="{StaticResource TextPrimaryBrush}" Content="Jogo abriu" />
                        <CheckBox x:Name="MenuReachedCheckBox" Margin="0,0,18,8" Foreground="{StaticResource TextPrimaryBrush}" Content="Chegou ao menu" />
                        <CheckBox x:Name="WorldEnteredCheckBox" Margin="0,0,18,8" Foreground="{StaticResource TextPrimaryBrush}" Content="Entrou no mundo" />
                        <CheckBox x:Name="ServerEnteredCheckBox" Margin="0,0,18,8" Foreground="{StaticResource TextPrimaryBrush}" Content="Entrou no servidor" />
                        <CheckBox x:Name="Playable720pCheckBox" Margin="0,0,18,8" Foreground="{StaticResource TextPrimaryBrush}" Content="Jogavel em 720p" />
                        <CheckBox x:Name="SevereDropsCheckBox" Margin="0,0,18,8" Foreground="{StaticResource TextPrimaryBrush}" Content="Quedas severas" />
                        <CheckBox x:Name="CrashedCheckBox" Margin="0,0,18,8" Foreground="{StaticResource TextPrimaryBrush}" Content="Crash" />
                        <CheckBox x:Name="OutOfMemoryCheckBox" Margin="0,0,0,8" Foreground="{StaticResource TextPrimaryBrush}" Content="Falta de memoria" />
                    </WrapPanel>

                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Style="{StaticResource MacSectionLabel}" Text="MENU (S)" />
                            <TextBox x:Name="MenuSecondsTextBox" Margin="0,5,0,0" Style="{StaticResource MinecraftTextBox}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="6,0">
                            <TextBlock Style="{StaticResource MacSectionLabel}" Text="ENTRADA (S)" />
                            <TextBox x:Name="JoinSecondsTextBox" Margin="0,5,0,0" Style="{StaticResource MinecraftTextBox}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="6,0">
                            <TextBlock Style="{StaticResource MacSectionLabel}" Text="FPS MEDIO" />
                            <TextBox x:Name="AverageFpsTextBox" Margin="0,5,0,0" Style="{StaticResource MinecraftTextBox}" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" Margin="6,0,0,0">
                            <TextBlock Style="{StaticResource MacSectionLabel}" Text="FPS MINIMO" />
                            <TextBox x:Name="MinimumFpsTextBox" Margin="0,5,0,0" Style="{StaticResource MinecraftTextBox}" />
                        </StackPanel>
                    </Grid>

                    <TextBox x:Name="OperationalNotesTextBox"
                             Height="56"
                             Margin="0,10,0,0"
                             Padding="12,8"
                             AcceptsReturn="True"
                             Background="{StaticResource CardElevatedBrush}"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             BorderBrush="{StaticResource CardBorderBrush}"
                             TextWrapping="Wrap"
                             ToolTip="Servidor, rota, resolucao, stutter e qualquer comportamento observado" />

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="ExportChecklistButton"
                                Grid.Column="0"
                                Width="154"
                                Style="{StaticResource MacSecondaryButton}"
                                Content="Exportar checklist"
                                Click="ExportChecklistButton_OnClick" />
                        <Button x:Name="SaveHomologationButton"
                                Grid.Column="1"
                                Width="172"
                                Margin="10,0,0,0"
                                Style="{StaticResource MacPrimaryButton}"
                                Content="Salvar resultado real"
                                Click="SaveHomologationButton_OnClick" />
                        <TextBlock x:Name="OperationalStatusText"
                                   Grid.Column="2"
                                   Margin="16,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextTertiaryBrush}"
                                   FontSize="11"
                                   Text="Aguardando uma instancia real e observacoes do teste."
                                   TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Margin="0,14,0,0" Style="{StaticResource MacCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Style="{StaticResource MacSectionLabel}" Text="BENCHMARK E RELATORIOS" />
                        <TextBlock x:Name="OperationText"
                                   Margin="0,7,0,0"
                                   Style="{StaticResource MacBodyText}"
                                   Text="Abra o Minecraft para medir RAM, CPU, configs, latest.log e crash reports. Sem processo, o resultado sera NAO_TESTADO." />
                        <TextBox x:Name="JavaArgumentsTextBox"
                                 Margin="0,10,0,0"
                                 Style="{StaticResource MinecraftTextBox}"
                                 IsReadOnly="True"
                                 Text="JVM recomendada aparecera aqui" />
                    </StackPanel>

                    <Button x:Name="BenchmarkButton"
                            Grid.Column="1"
                            Width="132"
                            Margin="18,0,0,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource MacSecondaryButton}"
                            Content="Benchmark 60 s"
                            Click="BenchmarkButton_OnClick" />
                    <Button x:Name="OpenReportsButton"
                            Grid.Column="2"
                            Width="126"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource MacSecondaryButton}"
                            Content="Abrir relatorios"
                            Click="OpenReportsButton_OnClick" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
