<UserControl x:Class="ApexTweaker.UI.Wpf.Views.TelemetryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <UserControl.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#2A2A2A" />
            <Setter Property="BorderBrush" Value="#3A3A3C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="20" />
        </Style>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42" />
            <Setter Property="Background" Value="#323234" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#404044" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="#3A3A3C" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="RootBorder" Property="Opacity" Value="0.86" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="RootBorder" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MetricValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="MetricCaptionStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#A1A1AA" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Teste A/B de Estabilidade"
                               Foreground="#00B4D8"
                               FontSize="22"
                               FontWeight="Bold" />
                    <Button x:Name="BenchmarkButton"
                            Margin="0,16,0,0"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Content="Iniciar Teste (Antes da Otimização)"
                            Click="BenchmarkButton_OnClick" />
                </StackPanel>
            </Border>

            <Border Margin="0,16,0,0" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Gráfico em tempo real"
                               Foreground="#00B4D8"
                               FontSize="22"
                               FontWeight="Bold" />
                    <Border Margin="0,16,0,0"
                            Background="#131827"
                            BorderBrush="#263048"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="12">
                        <Grid>
                            <Canvas x:Name="ChartCanvas"
                                    Height="220"
                                    SizeChanged="ChartCanvas_OnSizeChanged">
                                <Polyline x:Name="FpsPolyline"
                                          Stroke="#00B4D8"
                                          StrokeThickness="2" />
                                <Polyline x:Name="OnePercentPolyline"
                                          Stroke="#4ADE80"
                                          StrokeThickness="2" />
                            </Canvas>
                            <TextBlock x:Name="ChartPlaceholderText"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="#667085"
                                       FontSize="16"
                                       Text="Aguardando início do jogo..." />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Métricas de kernel e CPU"
                                   Foreground="#00B4D8"
                                   FontSize="20"
                                   FontWeight="Bold" />
                        <UniformGrid Margin="0,18,0,0" Rows="2" Columns="2">
                            <StackPanel Margin="0,0,12,16">
                                <TextBlock Style="{StaticResource MetricCaptionStyle}" Text="Pico de Latência DPC" />
                                <TextBlock x:Name="DpcLatencyText" Style="{StaticResource MetricValueStyle}" Text="0 µs" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,16">
                                <TextBlock Style="{StaticResource MetricCaptionStyle}" Text="Boost Drop" />
                                <TextBlock x:Name="BoostDropText" Style="{StaticResource MetricValueStyle}" Text="0 MHz" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Style="{StaticResource MetricCaptionStyle}" Text="CPU Package" />
                                <TextBlock x:Name="CpuPackageText" Style="{StaticResource MetricValueStyle}" Text="-- °C" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Style="{StaticResource MetricCaptionStyle}" Text="Clock de jogo" />
                                <TextBlock x:Name="EffectiveClockText" Style="{StaticResource MetricValueStyle}" Text="0 MHz" />
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Console"
                                   Foreground="#00B4D8"
                                   FontSize="20"
                                   FontWeight="Bold" />
                        <Border Margin="0,16,0,0"
                                Background="#141416"
                                BorderBrush="#343434"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="8">
                            <RichTextBox x:Name="ConsoleBox"
                                         Background="#141416"
                                         BorderThickness="0"
                                         FontFamily="Consolas"
                                         FontSize="13"
                                         Foreground="#F4F4F5"
                                         IsReadOnly="True"
                                         HorizontalScrollBarVisibility="Disabled"
                                         VerticalScrollBarVisibility="Auto" />
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
