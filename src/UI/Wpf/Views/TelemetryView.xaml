<UserControl x:Class="ApexTweaker.UI.Wpf.Views.TelemetryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource ContentBgBrush}"
             FontFamily="Segoe UI Variable Display, Segoe UI, Arial">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/MacTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Border Style="{StaticResource MacCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource MacSectionLabel}"
                               Text="BENCHMARK" />
                    <TextBlock Margin="0,6,0,0"
                               Style="{StaticResource MacPageTitle}"
                               FontSize="22"
                               Text="Teste A/B de estabilidade" />
                    <Button x:Name="BenchmarkButton"
                            Margin="0,18,0,0"
                            Style="{StaticResource MacPrimaryButton}"
                            Content="Iniciar teste (antes da otimiza&#x00E7;&#x00E3;o)"
                            Click="BenchmarkButton_OnClick" />
                </StackPanel>
            </Border>

            <Border Margin="0,14,0,0" Style="{StaticResource MacCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource MacSectionLabel}"
                               Text="FRAMETIME" />
                    <TextBlock Margin="0,6,0,0"
                               Style="{StaticResource MacSectionTitle}"
                               Text="Gr&#x00E1;fico em tempo real" />
                    <Border Margin="0,16,0,0"
                            Background="{DynamicResource ChartBgBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="0.5"
                            CornerRadius="12"
                            Padding="14">
                        <Grid>
                            <Canvas x:Name="ChartCanvas"
                                    Height="220"
                                    SizeChanged="ChartCanvas_OnSizeChanged">
                                <Polyline x:Name="FpsPolyline"
                                          Stroke="{DynamicResource AccentBrush}"
                                          StrokeThickness="2.5"
                                          StrokeLineJoin="Round"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" />
                                <Polyline x:Name="OnePercentPolyline"
                                          Stroke="{DynamicResource SuccessBrush}"
                                          StrokeThickness="2.5"
                                          StrokeLineJoin="Round"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" />
                            </Canvas>
                            <TextBlock x:Name="ChartPlaceholderText"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       FontSize="14"
                                       Text="Aguardando in&#x00ED;cio do jogo..." />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource MacCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MacSectionLabel}"
                                   Text="KERNEL" />
                        <TextBlock Margin="0,6,0,0"
                                   Style="{StaticResource MacSectionTitle}"
                                   Text="M&#x00E9;tricas de CPU" />
                        <UniformGrid Margin="0,18,0,0" Rows="2" Columns="2">
                            <StackPanel Margin="0,0,12,16">
                                <TextBlock Style="{StaticResource MacMetricCaption}" Text="Pico DPC" />
                                <TextBlock x:Name="DpcLatencyText" Style="{StaticResource MacMetricValue}" FontSize="20" Text="0 &#x00B5;s" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,16">
                                <TextBlock Style="{StaticResource MacMetricCaption}" Text="Boost drop" />
                                <TextBlock x:Name="BoostDropText" Style="{StaticResource MacMetricValue}" FontSize="20" Text="0 MHz" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Style="{StaticResource MacMetricCaption}" Text="CPU package" />
                                <TextBlock x:Name="CpuPackageText" Style="{StaticResource MacMetricValue}" FontSize="20" Text="-- &#x00B0;C" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Style="{StaticResource MacMetricCaption}" Text="Clock de jogo" />
                                <TextBlock x:Name="EffectiveClockText" Style="{StaticResource MacMetricValue}" FontSize="20" Text="0 MHz" />
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource MacCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MacSectionLabel}"
                                   Text="LOG" />
                        <TextBlock Margin="0,6,0,0"
                                   Style="{StaticResource MacSectionTitle}"
                                   Text="Console" />
                        <Border Margin="0,14,0,0"
                                Background="{DynamicResource ChartBgBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="0.5"
                                CornerRadius="10"
                                Padding="4">
                            <ListBox x:Name="ConsoleList"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     FontFamily="{StaticResource MacMonoFont}"
                                     FontSize="12"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     Focusable="False"
                                     HorizontalContentAlignment="Stretch"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="6,2" />
                                        <Setter Property="Margin" Value="0" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Focusable" Value="False" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="Transparent" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="Transparent" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Text}"
                                                   Foreground="{Binding Foreground}"
                                                   TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
