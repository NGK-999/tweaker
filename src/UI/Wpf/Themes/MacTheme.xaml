<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Shared theme tokens. AppThemeManager swaps these values in-place. -->
    <Color x:Key="WindowBgColor">#17181B</Color>
    <Color x:Key="SidebarBgColor">#141517</Color>
    <Color x:Key="ContentBgColor">#1B1D21</Color>
    <Color x:Key="CardBgColor">#212328</Color>
    <Color x:Key="CardElevatedColor">#2A2D33</Color>
    <Color x:Key="CardBorderColor">#2E3138</Color>
    <Color x:Key="AccentColor">#4B9E9E</Color>
    <Color x:Key="AccentPressedColor">#3A8484</Color>
    <Color x:Key="AccentHoverColor">#5CB0B0</Color>
    <Color x:Key="TextPrimaryColor">#EDEEF0</Color>
    <Color x:Key="TextSecondaryColor">#9AA0AC</Color>
    <Color x:Key="TextTertiaryColor">#6C7280</Color>
    <Color x:Key="SeparatorColor">#2A2D33</Color>
    <Color x:Key="DestructiveColor">#E5534B</Color>
    <Color x:Key="DestructiveHoverColor">#EF6B63</Color>
    <Color x:Key="SuccessColor">#4CAF7D</Color>
    <Color x:Key="WarningColor">#D8A657</Color>
    <Color x:Key="ErrorColor">#EF6B63</Color>
    <Color x:Key="TrafficRedColor">#FF5F57</Color>
    <Color x:Key="TrafficYellowColor">#FEBC2E</Color>
    <Color x:Key="TrafficGreenColor">#28C840</Color>
    <Color x:Key="ChartBgColor">#17181B</Color>
    <Color x:Key="NavHoverColor">#1E2024</Color>
    <Color x:Key="NavActiveColor">#20282A</Color>
    <Color x:Key="SecondaryHoverColor">#31343B</Color>
    <Color x:Key="ControlBgColor">#1B1D21</Color>
    <Color x:Key="ControlDisabledColor">#26282E</Color>
    <Color x:Key="SelectionColor">#1F3B3B</Color>
    <Color x:Key="FocusColor">#5CB0B0</Color>
    <Color x:Key="InfoSurfaceColor">#182A2A</Color>
    <Color x:Key="SuccessSurfaceColor">#16261E</Color>
    <Color x:Key="WarningSurfaceColor">#2A2317</Color>
    <Color x:Key="ErrorSurfaceColor">#2C1D1B</Color>
    <Color x:Key="PanelBgColor">#1B1D21</Color>
    <Color x:Key="PanelBorderColor">#2E3138</Color>
    <Color x:Key="OnAccentTextColor">#0B1414</Color>

    <SolidColorBrush x:Key="WindowBgBrush" Color="{StaticResource WindowBgColor}" />
    <SolidColorBrush x:Key="SidebarBgBrush" Color="{StaticResource SidebarBgColor}" />
    <SolidColorBrush x:Key="ContentBgBrush" Color="{StaticResource ContentBgColor}" />
    <SolidColorBrush x:Key="CardBgBrush" Color="{StaticResource CardBgColor}" />
    <SolidColorBrush x:Key="CardElevatedBrush" Color="{StaticResource CardElevatedColor}" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource CardBorderColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}" />
    <SolidColorBrush x:Key="SeparatorBrush" Color="{StaticResource SeparatorColor}" />
    <SolidColorBrush x:Key="DestructiveBrush" Color="{StaticResource DestructiveColor}" />
    <SolidColorBrush x:Key="DestructiveHoverBrush" Color="{StaticResource DestructiveHoverColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
    <SolidColorBrush x:Key="ChartBgBrush" Color="{StaticResource ChartBgColor}" />
    <SolidColorBrush x:Key="NavHoverBrush" Color="{StaticResource NavHoverColor}" />
    <SolidColorBrush x:Key="NavActiveBrush" Color="{StaticResource NavActiveColor}" />
    <SolidColorBrush x:Key="SecondaryHoverBrush" Color="{StaticResource SecondaryHoverColor}" />
    <SolidColorBrush x:Key="ControlBgBrush" Color="{StaticResource ControlBgColor}" />
    <SolidColorBrush x:Key="ControlDisabledBrush" Color="{StaticResource ControlDisabledColor}" />
    <SolidColorBrush x:Key="SelectionBrush" Color="{StaticResource SelectionColor}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{StaticResource FocusColor}" />
    <SolidColorBrush x:Key="InfoSurfaceBrush" Color="{StaticResource InfoSurfaceColor}" />
    <SolidColorBrush x:Key="SuccessSurfaceBrush" Color="{StaticResource SuccessSurfaceColor}" />
    <SolidColorBrush x:Key="WarningSurfaceBrush" Color="{StaticResource WarningSurfaceColor}" />
    <SolidColorBrush x:Key="ErrorSurfaceBrush" Color="{StaticResource ErrorSurfaceColor}" />
    <SolidColorBrush x:Key="PanelBgBrush" Color="{StaticResource PanelBgColor}" />
    <SolidColorBrush x:Key="PanelBorderBrush" Color="{StaticResource PanelBorderColor}" />
    <SolidColorBrush x:Key="OnAccentTextBrush" Color="{StaticResource OnAccentTextColor}" />

    <FontFamily x:Key="MacFont">Segoe UI Variable Display, Segoe UI, Arial</FontFamily>
    <FontFamily x:Key="MacMonoFont">Cascadia Mono, Consolas, monospace</FontFamily>

    <Style x:Key="ModernFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3"
                            BorderBrush="{DynamicResource FocusBrush}"
                            BorderThickness="2"
                            CornerRadius="8"
                            SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Motion -->
    <Duration x:Key="MotionFast">0:0:0.14</Duration>
    <Duration x:Key="MotionNormal">0:0:0.22</Duration>
    <Duration x:Key="MotionSlow">0:0:0.32</Duration>
    <PowerEase x:Key="MotionEaseOut" EasingMode="EaseOut" Power="4" />
    <PowerEase x:Key="MotionEaseIn" EasingMode="EaseIn" Power="3" />
    <CubicEase x:Key="MotionEaseInOut" EasingMode="EaseInOut" />

    <!-- Cards -->
    <Style x:Key="MacCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Typography -->
    <Style x:Key="MacPageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MacFont}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="MacSectionTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MacFont}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="MacSectionLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MacFont}" />
        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="MacBodyText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MacFont}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="20" />
    </Style>

    <Style x:Key="MacMetricValue" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MacFont}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="MacMetricCaption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MacFont}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- Primary button (Apple filled blue) -->
    <Style x:Key="MacPrimaryButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource MacFont}" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OnAccentTextBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource ModernFocusVisual}" />
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="RootGrid" SnapsToDevicePixels="True">
                        <Border x:Name="RootBorder"
                                Background="{DynamicResource AccentBrush}"
                                CornerRadius="8"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                        </Border>
                        <Border x:Name="HoverOverlay"
                                Background="{DynamicResource AccentHoverBrush}"
                                CornerRadius="8"
                                Opacity="0"
                                IsHitTestVisible="False" />
                        <Border x:Name="PressOverlay"
                                Background="{DynamicResource AccentPressedBrush}"
                                CornerRadius="8"
                                Opacity="0"
                                IsHitTestVisible="False" />
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <EventTrigger RoutedEvent="MouseEnter">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="1"
                                                     Duration="{StaticResource MotionFast}"
                                                     EasingFunction="{StaticResource MotionEaseOut}" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="MouseLeave">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="0"
                                                     Duration="{StaticResource MotionNormal}"
                                                     EasingFunction="{StaticResource MotionEaseInOut}" />
                                    <DoubleAnimation Storyboard.TargetName="PressOverlay"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="0"
                                                     Duration="{StaticResource MotionFast}" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressOverlay"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1"
                                                         Duration="0:0:0.08"
                                                         EasingFunction="{StaticResource MotionEaseOut}" />
                                        <DoubleAnimation Storyboard.TargetName="RootBorder"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="0.97"
                                                         Duration="0:0:0.08"
                                                         EasingFunction="{StaticResource MotionEaseOut}" />
                                        <DoubleAnimation Storyboard.TargetName="RootBorder"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="0.97"
                                                         Duration="0:0:0.08"
                                                         EasingFunction="{StaticResource MotionEaseOut}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressOverlay"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0"
                                                         Duration="{StaticResource MotionFast}"
                                                         EasingFunction="{StaticResource MotionEaseInOut}" />
                                        <DoubleAnimation Storyboard.TargetName="RootBorder"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="1"
                                                         Duration="{StaticResource MotionNormal}"
                                                         EasingFunction="{StaticResource MotionEaseOut}" />
                                        <DoubleAnimation Storyboard.TargetName="RootBorder"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="1"
                                                         Duration="{StaticResource MotionNormal}"
                                                         EasingFunction="{StaticResource MotionEaseOut}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="RootGrid" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MacSecondaryButton" TargetType="Button" BasedOn="{StaticResource MacPrimaryButton}">
        <Setter Property="Height" Value="40" />
        <Setter Property="Background" Value="{DynamicResource CardElevatedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="RootGrid" SnapsToDevicePixels="True">
                        <Border x:Name="RootBorder"
                                Background="{DynamicResource CardElevatedBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="0.5"
                                CornerRadius="8"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                        </Border>
                        <Border x:Name="HoverOverlay"
                                Background="{DynamicResource SecondaryHoverBrush}"
                                CornerRadius="8"
                                Opacity="0"
                                IsHitTestVisible="False" />
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <EventTrigger RoutedEvent="MouseEnter">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="1"
                                                     Duration="{StaticResource MotionFast}"
                                                     EasingFunction="{StaticResource MotionEaseOut}" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="MouseLeave">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="0"
                                                     Duration="{StaticResource MotionNormal}"
                                                     EasingFunction="{StaticResource MotionEaseInOut}" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RootBorder"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="0.98"
                                                         Duration="0:0:0.08"
                                                         EasingFunction="{StaticResource MotionEaseOut}" />
                                        <DoubleAnimation Storyboard.TargetName="RootBorder"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="0.98"
                                                         Duration="0:0:0.08"
                                                         EasingFunction="{StaticResource MotionEaseOut}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RootBorder"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="1"
                                                         Duration="{StaticResource MotionNormal}"
                                                         EasingFunction="{StaticResource MotionEaseOut}" />
                                        <DoubleAnimation Storyboard.TargetName="RootBorder"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="1"
                                                         Duration="{StaticResource MotionNormal}"
                                                         EasingFunction="{StaticResource MotionEaseOut}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="RootGrid" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MacModuleButton" TargetType="Button" BasedOn="{StaticResource MacSecondaryButton}">
        <Setter Property="Width" Value="168" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Margin" Value="0,0,10,10" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style x:Key="MacDestructiveButton" TargetType="Button" BasedOn="{StaticResource MacSecondaryButton}">
        <Setter Property="Background" Value="{DynamicResource DestructiveBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource OnAccentTextBrush}" />
    </Style>

    <!-- Sidebar navigation: quieter chrome, taller hit targets, accent bar when active -->
    <Style x:Key="MacNavButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource MacFont}" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource ModernFocusVisual}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="14,0,12,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="HoverOverlay"
                                Background="{DynamicResource NavHoverBrush}"
                                CornerRadius="8"
                                Opacity="0"
                                IsHitTestVisible="False" />
                        <Border x:Name="ActiveOverlay"
                                Background="{DynamicResource NavActiveBrush}"
                                CornerRadius="8"
                                Opacity="0"
                                IsHitTestVisible="False" />
                        <Border x:Name="ActiveBar"
                                Width="3"
                                Margin="0,6,0,6"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource AccentBrush}"
                                CornerRadius="1.5"
                                Opacity="0"
                                IsHitTestVisible="False" />
                        <ContentPresenter VerticalAlignment="Center"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          Margin="{TemplateBinding Padding}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <EventTrigger RoutedEvent="MouseEnter">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="1"
                                                     Duration="{StaticResource MotionFast}"
                                                     EasingFunction="{StaticResource MotionEaseOut}" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="MouseLeave">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="0"
                                                     Duration="{StaticResource MotionNormal}"
                                                     EasingFunction="{StaticResource MotionEaseInOut}" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <Trigger Property="Tag" Value="Active">
                            <Setter TargetName="ActiveOverlay" Property="Opacity" Value="1" />
                            <Setter TargetName="ActiveBar" Property="Opacity" Value="1" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Windows caption buttons -->
    <Style x:Key="WinCaptionButton" TargetType="Button">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource ModernFocusVisual}" />
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="RootBorder" Background="Transparent" />
                        <Border x:Name="HoverOverlay"
                                Background="{DynamicResource NavHoverBrush}"
                                Opacity="0"
                                IsHitTestVisible="False" />
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <EventTrigger RoutedEvent="MouseEnter">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="1"
                                                     Duration="{StaticResource MotionFast}"
                                                     EasingFunction="{StaticResource MotionEaseOut}" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="MouseLeave">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="0"
                                                     Duration="{StaticResource MotionNormal}"
                                                     EasingFunction="{StaticResource MotionEaseInOut}" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="HoverOverlay" Property="Background" Value="{DynamicResource NavActiveBrush}" />
                            <Setter TargetName="HoverOverlay" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WinCloseButton" TargetType="Button" BasedOn="{StaticResource WinCaptionButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="RootBorder" Background="Transparent" />
                        <Border x:Name="HoverOverlay"
                                Background="{DynamicResource DestructiveBrush}"
                                Opacity="0"
                                IsHitTestVisible="False" />
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <EventTrigger RoutedEvent="MouseEnter">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="1"
                                                     Duration="{StaticResource MotionFast}"
                                                     EasingFunction="{StaticResource MotionEaseOut}" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="MouseLeave">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="0"
                                                     Duration="{StaticResource MotionNormal}"
                                                     EasingFunction="{StaticResource MotionEaseInOut}" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource OnAccentTextBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="HoverOverlay" Property="Background" Value="{DynamicResource DestructiveHoverBrush}" />
                            <Setter TargetName="HoverOverlay" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Standard WPF controls -->
    <Style TargetType="TextBox">
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="FontFamily" Value="{StaticResource MacFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource ControlBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource SelectionBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource ModernFocusVisual}" />
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                <Setter Property="BorderThickness" Value="2" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource ControlDisabledBrush}" />
