<Window x:Class="ApexTweaker.UI.Wpf.Windows.LoadingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inicializando"
        Width="420"
        Height="180"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#1E1E1E"
        WindowStyle="None"
        ShowInTaskbar="False"
        Loaded="Window_OnLoaded">
    <Border Margin="16"
            Background="#252525"
            BorderBrush="#3A3A3C"
            BorderThickness="1"
            CornerRadius="14"
            Padding="24">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Inicializando motor Apex..."
                       Foreground="White"
                       FontSize="22"
                       FontWeight="Bold" />
            <TextBlock Margin="0,8,0,18"
                       Foreground="#A1A1AA"
                       Text="Carregando a nova casca WPF e acoplando o backend existente." />
            <ProgressBar Height="8"
                         IsIndeterminate="True"
                         Foreground="#00B4D8"
                         Background="#38383A" />
        </StackPanel>
    </Border>
</Window>
