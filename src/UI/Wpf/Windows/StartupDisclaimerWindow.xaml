<Window x:Class="ApexTweaker.UI.Wpf.Windows.StartupDisclaimerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aviso de Responsabilidade"
        Width="560"
        Height="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="Transparent"
        FontFamily="Segoe UI Variable Display, Segoe UI, Arial"
        WindowStyle="None"
        ShowInTaskbar="False"
        KeyboardNavigation.TabNavigation="Cycle"
        AllowsTransparency="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/MacTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Margin="12"
            Background="{DynamicResource CardBgBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="0.5"
            CornerRadius="16"
            Padding="28"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="Aviso de responsabilidade"
                       Style="{StaticResource MacPageTitle}"
                       FontSize="22" />

            <TextBlock Grid.Row="1"
                       Margin="0,16,0,16"
                       Style="{StaticResource MacBodyText}"
                       Text="O modo normal audita e otimiza instancias Minecraft sem administrador. Acoes de energia, registro, BCD e rollback do Windows solicitam UAC separadamente e so devem ser aplicadas se voce entender os riscos operacionais." />

            <StackPanel Grid.Row="2">
                <CheckBox x:Name="AcceptCheckBox"
                          Margin="0,0,0,18"
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          FontSize="13"
                          Content="Eu compreendo os riscos e assumo total responsabilidade."
                          Checked="AcceptCheckBox_OnChecked"
                          Unchecked="AcceptCheckBox_OnChecked" />
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Width="110"
                            Height="36"
                            Margin="0,0,10,0"
                            Style="{StaticResource MacSecondaryButton}"
                            Content="Cancelar"
                            IsCancel="True"
                            AutomationProperties.Name="Cancelar e fechar o ApexTweaker"
                            Click="CancelButton_OnClick" />
                    <Button x:Name="ConfirmButton"
                            Width="110"
                            Height="36"
                            Style="{StaticResource MacPrimaryButton}"
                            Content="Continuar"
                            IsEnabled="False"
                            IsDefault="True"
                            AutomationProperties.Name="Aceitar aviso e continuar"
                            Click="ConfirmButton_OnClick" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
