<Window x:Class="ApexTweaker.UI.Wpf.Windows.StartupDisclaimerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aviso de Responsabilidade"
        Width="620"
        Height="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#1E1E1E"
        WindowStyle="ToolWindow"
        ShowInTaskbar="False">
    <Border Margin="18"
            Background="#252525"
            BorderBrush="#3A3A3C"
            BorderThickness="1"
            CornerRadius="14"
            Padding="22">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="Aviso de Responsabilidade"
                       Foreground="White"
                       FontSize="24"
                       FontWeight="Bold" />

            <TextBlock Grid.Row="1"
                       Margin="0,18,0,18"
                       Foreground="#D4D4D8"
                       FontSize="14"
                       TextWrapping="Wrap"
                       Text="O ApexTweaker altera energia, registro, BCD e prioridades do sistema. O pipeline transacional e o rollback foram preservados, mas ainda assim você deve aplicar os pacotes apenas se entender os riscos operacionais da máquina." />

            <StackPanel Grid.Row="2">
                <CheckBox x:Name="AcceptCheckBox"
                          Margin="0,0,0,16"
                          Foreground="#F4F4F5"
                          Content="Eu compreendo os riscos e assumo total responsabilidade."
                          Checked="AcceptCheckBox_OnChecked"
                          Unchecked="AcceptCheckBox_OnChecked" />
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Width="120"
                            Height="38"
                            Margin="0,0,12,0"
                            Background="#38383A"
                            BorderBrush="#38383A"
                            Foreground="White"
                            Content="Cancelar"
                            Click="CancelButton_OnClick" />
                    <Button x:Name="ConfirmButton"
                            Width="120"
                            Height="38"
                            Background="#00B4D8"
                            BorderBrush="#00B4D8"
                            Foreground="White"
                            Content="Continuar"
                            IsEnabled="False"
                            Click="ConfirmButton_OnClick" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
