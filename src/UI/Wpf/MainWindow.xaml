<Window x:Class="ApexTweaker.UI.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="ApexTweaker"
        Width="1180"
        Height="780"
        MinWidth="980"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        FontFamily="Segoe UI Variable Display, Segoe UI, Arial"
        WindowStyle="None"
        ResizeMode="CanResize"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        AllowsTransparency="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="52"
                            CornerRadius="12"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="8"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/MacTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{StaticResource WindowBgBrush}"
            BorderBrush="{StaticResource SeparatorBrush}"
            BorderThickness="0.5"
            CornerRadius="12"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Grid.Row="0"
                  Background="{StaticResource SidebarBgBrush}"
                  MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextTertiaryBrush}"
                           FontSize="12"
                           Text="ApexTweaker" />

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="MinimizeButton"
                            Style="{StaticResource WinCaptionButton}"
                            Content="&#xE921;"
                            ToolTip="Minimizar"
                            Click="MinimizeButton_OnClick" />
                    <Button x:Name="MaximizeButton"
                            Style="{StaticResource WinCaptionButton}"
                            Content="&#xE922;"
                            ToolTip="Maximizar"
                            Click="MaximizeButton_OnClick" />
                    <Button x:Name="CloseButton"
                            Style="{StaticResource WinCloseButton}"
                            Content="&#xE8BB;"
                            ToolTip="Fechar"
                            Click="CloseButton_OnClick" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <Border Grid.Column="0"
                        Background="{StaticResource SidebarBgBrush}"
                        BorderBrush="{StaticResource SeparatorBrush}"
                        BorderThickness="0,0,0.5,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Margin="16,20,16,0">
                            <TextBlock Text="ApexTweaker"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="22"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="AppVersionText"
                                       Margin="0,4,0,0"
                                       Foreground="{StaticResource TextTertiaryBrush}"
                                       FontSize="12"
                                       Text="v0.0.0" />
                            <TextBlock x:Name="PrivilegeModeText"
                                       Margin="0,4,0,0"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontSize="11"
                                       Text="Modo normal" />
                        </StackPanel>

                        <StackPanel Grid.Row="1"
                                    Margin="12,24,12,0"
                                    VerticalAlignment="Top">
                            <Button x:Name="DashboardButton"
                                    Content="Dashboard"
                                    Style="{StaticResource MacNavButton}"
                                    Click="DashboardButton_OnClick" />
                            <Button x:Name="ModulesButton"
                                    Content="M&#x00F3;dulos"
                                    Style="{StaticResource MacNavButton}"
                                    Click="ModulesButton_OnClick" />
                            <Button x:Name="TelemetryButton"
                                    Content="Telemetria"
                                    Style="{StaticResource MacNavButton}"
                                    Click="TelemetryButton_OnClick" />
                            <Button x:Name="MinecraftButton"
                                    Content="Minecraft R&#x00E1;pido"
                                    Style="{StaticResource MacNavButton}"
                                    Click="MinecraftButton_OnClick" />
                            <Button x:Name="UtilitiesButton"
                                    Content="Utilidades"
                                    Style="{StaticResource MacNavButton}"
                                    Click="UtilitiesButton_OnClick" />
                        </StackPanel>

                        <TextBlock Grid.Row="2"
                                   Margin="16,0,16,20"
                                   Foreground="{StaticResource TextTertiaryBrush}"
                                   FontSize="11"
                                   Text="Igor Silva" />
                    </Grid>
                </Border>

                <!-- Content -->
                <Grid Grid.Column="1"
                      Background="{StaticResource ContentBgBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0"
                                Margin="32,28,32,0">
                        <TextBlock x:Name="HeaderTitleText"
                                   Style="{StaticResource MacPageTitle}"
                                   Text="Dashboard" />
                        <TextBlock x:Name="HeaderSubtitleText"
                                   Margin="0,6,0,0"
                                   Style="{StaticResource MacBodyText}"
                                   Text="Performance, telemetria e rollback transacional" />
                    </StackPanel>

                    <ContentControl x:Name="PageHost"
                                    Grid.Row="1"
                                    Margin="32,20,32,12"
                                    SnapsToDevicePixels="True"
                                    UseLayoutRounding="True"
                                    RenderOptions.BitmapScalingMode="HighQuality"
                                    RenderOptions.CachingHint="Cache" />

                    <Border Grid.Row="2"
                            Margin="32,0,32,24"
                            Padding="0,12,0,0"
                            BorderBrush="{StaticResource SeparatorBrush}"
                            BorderThickness="0,0.5,0,0">
                        <TextBlock x:Name="StatusText"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontSize="13"
                                   Text="Pronto." />
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
