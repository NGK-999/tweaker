<Window x:Class="ApexTweaker.UI.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:ApexTweaker.UI.Wpf.Controls"
        Title="ApexTweaker"
        Width="1180"
        Height="780"
        MinWidth="980"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        FontFamily="Segoe UI Variable Display, Segoe UI, Arial"
        WindowStyle="None"
        ResizeMode="CanResize"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        KeyboardNavigation.TabNavigation="Cycle"
        AllowsTransparency="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="52"
                            CornerRadius="12"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="8"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/MacTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{DynamicResource WindowBgBrush}"
            BorderBrush="{DynamicResource SeparatorBrush}"
            BorderThickness="0.5"
            CornerRadius="12"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Grid.Row="0"
                  Background="{DynamicResource SidebarBgBrush}"
                  MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           FontSize="12"
                           Text="ApexTweaker" />

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="MinimizeButton"
                            Style="{StaticResource WinCaptionButton}"
                            Content="&#xE921;"
                            ToolTip="Minimizar"
                            Click="MinimizeButton_OnClick" />
                    <Button x:Name="MaximizeButton"
                            Style="{StaticResource WinCaptionButton}"
                            Content="&#xE922;"
                            ToolTip="Maximizar"
                            Click="MaximizeButton_OnClick" />
                    <Button x:Name="CloseButton"
                            Style="{StaticResource WinCloseButton}"
                            Content="&#xE8BB;"
                            ToolTip="Fechar"
                            Click="CloseButton_OnClick" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <Border Grid.Column="0"
                        Background="{DynamicResource SidebarBgBrush}"
                        BorderBrush="{DynamicResource SeparatorBrush}"
                        BorderThickness="0,0,0.5,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Margin="16,18,16,0">
                            <TextBlock Text="ApexTweaker"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="14"
                                       FontWeight="SemiBold" />
                        </StackPanel>

                        <StackPanel Grid.Row="1"
                                    Margin="12,16,12,0"
                                    VerticalAlignment="Top">
                            <TextBlock Margin="10,0,0,6"
                                       Style="{StaticResource MacSectionLabel}"
                                       Text="INICIO" />
                            <Button x:Name="DashboardButton"
                                    Content="Dashboard"
                                    Style="{StaticResource MacNavButton}"
                                    AutomationProperties.Name="Abrir Dashboard"
                                    Click="DashboardButton_OnClick" />
                            <Button x:Name="PerformanceButton"
                                    Content="Desempenho"
                                    Style="{StaticResource MacNavButton}"
                                    AutomationProperties.Name="Abrir Desempenho"
                                    Click="PerformanceButton_OnClick" />

                            <TextBlock Margin="10,14,0,6"
                                       Style="{StaticResource MacSectionLabel}"
                                       Text="AJUSTES" />
                            <Button x:Name="ModulesButton"
                                    Content="Modulos"
                                    Style="{StaticResource MacNavButton}"
                                    AutomationProperties.Name="Abrir Modulos"
                                    Click="ModulesButton_OnClick" />
                            <Button x:Name="CatalogButton"
                                    Content="Catalogo"
                                    Style="{StaticResource MacNavButton}"
                                    AutomationProperties.Name="Abrir Catalogo de otimizacoes"
                                    Click="CatalogButton_OnClick" />

                            <TextBlock Margin="10,14,0,6"
                                       Style="{StaticResource MacSectionLabel}"
                                       Text="SISTEMA" />
                            <Button x:Name="TelemetryButton"
                                    Content="Telemetria"
                                    Style="{StaticResource MacNavButton}"
                                    AutomationProperties.Name="Abrir Telemetria"
                                    Click="TelemetryButton_OnClick" />
                            <Button x:Name="UtilitiesButton"
                                    Content="Utilidades"
                                    Style="{StaticResource MacNavButton}"
                                    AutomationProperties.Name="Abrir Utilidades"
                                    Click="UtilitiesButton_OnClick" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Margin="12,0,12,16">
                            <Button x:Name="ThemeButton"
                                    Height="34"
                                    Padding="12,0"
                                    HorizontalContentAlignment="Left"
                                    Style="{StaticResource MacSecondaryButton}"
                                    Content="Tema claro"
                                    AutomationProperties.Name="Alternar tema claro ou escuro"
                                    Click="ThemeButton_OnClick" />
                            <Border Margin="0,12,0,0"
                                    Padding="0,10,0,0"
                                    BorderThickness="0,1,0,0"
                                    BorderBrush="{DynamicResource SeparatorBrush}">
                                <StackPanel>
                                    <TextBlock x:Name="AppVersionText"
                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                               FontSize="11"
                                               Text="v0.0.0" />
                                    <TextBlock x:Name="PrivilegeModeText"
                                               Margin="0,3,0,0"
                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                               FontSize="11"
                                               Text="Modo normal" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Content -->
                <Grid Grid.Column="1"
                      Background="{DynamicResource ContentBgBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0"
                                Margin="32,28,32,0">
                        <TextBlock x:Name="HeaderTitleText"
                                   Style="{StaticResource MacPageTitle}"
                                   Text="Dashboard" />
                        <TextBlock x:Name="HeaderSubtitleText"
                                   Margin="0,6,0,0"
                                   Style="{StaticResource MacBodyText}"
                                   Text="Performance, telemetria e rollback transacional" />
                    </StackPanel>

                    <ContentControl x:Name="PageHost"
                                    Grid.Row="1"
                                    Margin="32,20,32,12"
                                    SnapsToDevicePixels="True"
                                    UseLayoutRounding="True"
                                    RenderOptions.BitmapScalingMode="HighQuality"
                                    RenderOptions.CachingHint="Cache" />

                    <Border Grid.Row="2"
                            Margin="32,0,32,24"
                            Padding="12,9"
                            Background="{DynamicResource CardBgBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                        <TextBlock x:Name="StatusText"
                                   Foreground="{DynamicResource AccentBrush}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Text="Pronto." />
                    </Border>

                    <controls:Snackbar x:Name="ShellSnackbar" Grid.Row="1" Grid.RowSpan="2" Panel.ZIndex="50" />
                </Grid>
            </Grid>

            <!-- Ctrl+K command palette overlay -->
            <Border x:Name="CommandPaletteOverlay"
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Background="#99000000"
                    Visibility="Collapsed"
                    Panel.ZIndex="100"
                    MouseLeftButtonDown="CommandPaletteOverlay_OnMouseLeftButtonDown">
                <Border Width="480"
                        MaxHeight="380"
                        Margin="0,90,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Background="{DynamicResource CardBgBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        MouseLeftButtonDown="CommandPaletteBox_OnMouseLeftButtonDown">
                    <StackPanel Margin="4">
                        <TextBox x:Name="CommandPaletteInput"
                                 Margin="10,10,10,6"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 FontSize="15"
                                 TextChanged="CommandPaletteInput_OnTextChanged"
                                 PreviewKeyDown="CommandPaletteInput_OnPreviewKeyDown" />
                        <Border Height="1" Margin="4,0,4,4" Background="{DynamicResource SeparatorBrush}" />
                        <ListBox x:Name="CommandPaletteList"
                                 MaxHeight="290"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 PreviewMouseLeftButtonUp="CommandPaletteList_OnPreviewMouseLeftButtonUp">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="10,7">
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Margin="0,2,0,0"
                                                   Text="{Binding Subtitle}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Border>
</Window>
